---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';

const stages: { label: string; description: string; href: string }[] = [
  { label: 'Prepare', description: 'the medium and the tray', href: '/supplies/prepare' },
  { label: 'Graft', description: 'the sleeve and the clip', href: '/supplies/graft' },
  { label: 'Root', description: 'the mist and the bench', href: '/supplies/root' },
  { label: 'Protect', description: 'the hygiene protocol', href: '/supplies/protect' },
  { label: 'Record', description: 'the label and the logbook', href: '/supplies/record' },
];

const weeks: { day: string; body: string }[] = [
  {
    day: 'Day −7 · Filling.',
    body: 'Trays are filled and the medium settles. Fill short and you lose root volume; fill over and water cannot leave the base of the cell.',
  },
  {
    day: 'Day 0 · The cut.',
    body: 'Scion and rootstock are cut at roughly the same angle, brought into line and sleeved. From this moment nothing about whether it worked is visible.',
  },
  {
    day: 'Days 2–7 · Callus.',
    body: 'A layer of undifferentiated tissue forms across the cut. The plant cannot draw water through the join yet, so the air around the leaf has to stay wet — which is also excellent weather for disease, hence the hygiene protocol.',
  },
  {
    day: 'Days 10–21 · Roots.',
    body: 'Roots push from the base while the join is still setting. Both want the same conditions at the same time. This is the stage that separates a good propagation house from an average one.',
  },
  {
    day: 'Days 18–24 · Weaning and hardening.',
    body: 'Misting is stepped down week by week and light is raised, so the plant learns to hold its own water before it is moved.',
  },
  {
    day: 'Day 28 · The count.',
    body: 'Take is assessed as the presence of both a shoot and roots. That number is what the month was for.',
  },
];
---

<BaseLayout
  title="How grafting works"
  description="Two plants, one join, four weeks — how a graft is made, why roses are done differently, and what the numbers look like in Kenya."
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">HOW GRAFTING WORKS</p>
        <h1>Two plants, one join, four weeks.</h1>
        <p class="standfirst">
          If you have never stood in a propagation house, this page is the whole thing in five
          minutes. If you have, skip to the specifications.
        </p>
      </div>
      <TitleBlock drawingNo="PA-008" subject="THE PROCESS" dimension="≈ 28 DAYS" />
    </div>
  </section>

  <article class="body">
    <div class="body-inner">
      <section class="section">
        <h2>What grafting is</h2>
        <p>
          Grafting joins the top of one plant to the roots of another. The top — the
          <strong>scion</strong> — is the variety you want to sell: a particular rose, a particular
          mango. The bottom — the <strong>rootstock</strong> — is chosen for what happens
          underground: vigour, tolerance of the soil, resistance to what lives in it.
        </p>
        <p>
          Cut both at a matching angle, press the faces together, hold them still, and the two knit
          into one plant. It is the oldest trick in horticulture and almost every commercial rose in
          Kenya is made this way.
        </p>
      </section>

      <section class="section">
        <h2>Why roses are done slightly differently</h2>
        <p>
          In most grafting, the rootstock is already a rooted plant. In commercial rose propagation
          it usually is not. A cutting is taken and grafted in the same operation, so the join forms{' '}
          <em>while</em> the rootstock is still growing its own roots. The technique has a name —{' '}
          <strong>stenting</strong> — and it matters here because it means the join has to be held
          mechanically the entire time, under mist, with nothing underneath it yet.
        </p>
        <p>That is what a silicone sleeve is for.</p>
      </section>

      <section class="section">
        <h2>The four weeks, day by day</h2>
        <dl class="timeline">
          {weeks.map((w) => (
            <div class="timeline-row">
              <dt>{w.day}</dt>
              <dd>{w.body}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="section">
        <h2>What "take" means, and what it looks like in Kenya</h2>
        <p>
          <strong>Take</strong> is the share of grafts that produce both a shoot and roots, counted
          at four weeks. It is the number a propagation manager manages to, and it is sensitive to
          things that sound small.
        </p>
        <p>
          Published Kenyan work illustrates the range. In a study of the rose variety 'Inca' by
          Otiende, Nyabundi and Ngamau (<em>Journal of Applied Horticulture</em>, 18(1), 2016),
          grafting take on Natal Briar rootstock reached <strong>85.2 %</strong> from cuttings taken
          low on the mother shoot, while the rootstock 'Rosa Progress' averaged
          <strong>60.0 %</strong> across the trial. Cuttings from the base of the shoot outperformed
          cuttings from the top on both rootstocks, and auxin treatment beat none.
        </p>
        <p>
          Those are figures from one Kenyan trial on one variety, not a promise about your house.
          The point is the size of the gap: the difference between a good decision and a careless
          one at this stage is tens of points of take.
        </p>
      </section>

      <section class="section">
        <h2>Where each thing we sell fits</h2>
        <ul class="stage-list">
          {stages.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
              <span class="arrow" aria-hidden="true">
                →
              </span>
              <span>{s.description}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="section">
        <h2>A word on grafted vegetables</h2>
        <p>
          Grafting tomatoes, peppers and cucurbits onto resistant rootstock is well established in
          several countries and is used mainly against soil-borne disease. In Kenya it is
          <strong>emerging rather than established</strong>. The documented programme is run by
          Egerton University with Nanjing Agricultural University across 18 demonstration sites in
          Nakuru, Kisumu, Bomet and Subukia. We supply the consumables for it, and we will say
          plainly that the established, repeat-volume grafting in this market is roses and fruit
          trees.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-5);
  }

  .hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr auto;
    }
  }

  .hero-copy .eyebrow {
    margin-bottom: var(--space-2);
  }

  .standfirst {
    margin-top: var(--space-3);
    max-width: 46em;
    font-size: 18px;
    color: var(--ink-soft);
  }

  .body {
    padding-bottom: var(--space-7);
  }

  .body-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .section {
    max-width: 42em;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    margin-top: var(--space-5);
  }

  .section:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .section h2 {
    margin-bottom: var(--space-3);
  }

  .section p + p {
    margin-top: var(--space-2);
  }

  .timeline {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline-row {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
  }

  .timeline-row:first-child {
    border-top: none;
  }

  .timeline dt {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--signal-ink);
    margin: 0 0 4px;
  }

  .timeline dd {
    margin: 0;
    color: var(--ink);
  }

  .stage-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    padding: var(--space-1) 0;
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 13px;
  }

  .stage-list li:first-child {
    border-top: none;
  }

  .stage-list a {
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }

  .stage-list a:hover {
    color: var(--green);
  }

  .stage-list .arrow {
    color: var(--ink-soft);
  }
</style>
