---
import BaseLayout from '../layouts/BaseLayout.astro';
import houseWideImg from '../assets/images/house-wide.jpg';
import PageHero from '../components/PageHero.astro';
import NotesBlock from '../components/supplies/NotesBlock.astro';

interface StageEntry {
  number: string;
  name: string;
  href: string;
  sentence: string;
  chips: string[];
}

const STAGES: StageEntry[] = [
  {
    number: '01',
    name: 'Prepare',
    href: '/supplies/prepare',
    sentence: 'Filling trays and getting the growing medium right, before anything is cut.',
    chips: [
      'PRO-VERM F · M · C',
      'PRO-PEAT SEED · PROP · GRAFT',
      'Trays 104–288 cell',
      'Pots, polybags, blades',
    ],
  },
  {
    number: '02',
    name: 'Graft',
    href: '/supplies/graft',
    sentence: 'Joining the two halves and holding them still while they knit together.',
    chips: [
      'PRO-ROSE 35 → 85',
      'PRO-VEG · PRO-CUC · PRO-TREE',
      'Clips: U, Omega, Round, Tomato, V',
    ],
  },
  {
    number: '03',
    name: 'Root',
    href: '/supplies/root',
    sentence: 'Keeping the leaf damp and the base drained for the weeks that follow.',
    chips: [
      'Misting and fogging',
      'Benching and racking',
      'Drip, ebb and flow',
      'Shade, screening, LED',
      'Sensors and dashboard',
    ],
  },
  {
    number: '04',
    name: 'Protect',
    href: '/supplies/protect',
    sentence: 'Keeping the house clean enough that nothing spreads through a whole batch.',
    chips: [
      'PRO-SAN 10 · PRO-SAN 12',
      'Footbaths and tool stations',
      'Algae and biofilm control',
      'Sprayers, PPE',
    ],
  },
  {
    number: '05',
    name: 'Record',
    href: '/supplies/record',
    sentence: 'Knowing which batch came from where, and being able to prove it later.',
    chips: ['PRO-LABEL LOOP · T', 'PRO-TRACE · TRACE CARD', 'PRO-QC logbooks', 'PRO-MARK'],
  },
];
---

<BaseLayout
  title="Supplies"
  description="Five stages, from filling a tray to filing the record. We stock the consumables each one uses, and we specify and source the equipment around them. One"
>
  <PageHero
    eyebrow="WHAT WE SUPPLY"
    title="Everything a propagation house gets through in a month."
    standfirst="Five stages, from filling a tray to filing the record. We stock the consumables each one uses, and we specify and source the equipment around them. One framework agreement, one monthly call-off, one delivery."
    image={houseWideImg}
    imageAlt="A worker tending trays of young rose cuttings along a misted greenhouse bench"
  />

  <section class="stage-list">
    <ul>
      {STAGES.map((stage) => (
        <li class="stage-row">
          <a href={stage.href} class="stage-row-link">
            <span class="stage-number mono">{stage.number}</span>
            <span class="stage-body">
              <span class="stage-name">{stage.name}</span>
              <span class="stage-sentence">{stage.sentence}</span>
              <span class="stage-chips mono">
                {stage.chips.map((chip) => (
                  <span class="chip">{chip}</span>
                ))}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="closing-note">
    <NotesBlock>
      <p>
        EQUIPMENT AT STAGE 03 IS SPECIFIED AND SOURCED TO YOUR HOUSE. CONSUMABLES ARE HELD IN
        NAIROBI STOCK.
      </p>
    </NotesBlock>
  </section>
</BaseLayout>

<style>
  .stage-list,
  .closing-note {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .stage-list {
    padding-top: var(--space-2);
  }

  .stage-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage-row {
    border-top: 1px solid var(--rule);
  }

  .stage-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .stage-row-link {
    display: grid;
    grid-template-columns: 3em 1fr;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--ink);
    padding: var(--space-3) 0;
  }

  .stage-row-link:hover .stage-name {
    color: var(--green);
  }

  .stage-number {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .stage-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stage-name {
    font-family: var(--f-sans);
    font-weight: 700;
    font-size: 20px;
  }

  .stage-sentence {
    color: var(--ink-soft);
    max-width: 46em;
  }

  .stage-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .closing-note {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }
</style>
