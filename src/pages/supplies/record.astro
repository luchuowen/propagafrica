---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import StageHeader from '../../components/supplies/StageHeader.astro';
import SpecTable from '../../components/supplies/SpecTable.astro';
import NotesBlock from '../../components/supplies/NotesBlock.astro';
import StageNav from '../../components/supplies/StageNav.astro';
import QuotationBlock from '../../components/supplies/QuotationBlock.astro';
import TraceabilityChainFigure from '../../assets/figures/supplies/traceability-chain.svg';
import { specTable } from '../../data/products/tables';

const tables = {
  traceability: specTable('traceability'),
};
---

<BaseLayout
  title="Record"
  description="An audit does not ask whether your hygiene was good. It asks which mother block a batch came from, who grafted it, what was applied and what survived —"
>
  <StageHeader
    eyebrow="STAGE 05 · RECORD"
    title="Labels, batch cards and record books."
    standfirst="An audit does not ask whether your hygiene was good. It asks which mother block a batch came from, who grafted it, what was applied and what survived — and it asks you to produce that from a file, years later."
    titleBlockRows={[
      { label: 'DRAWING', value: 'PA-007' },
      { label: 'SUBJECT', value: 'TRACEABILITY' },
      { label: 'FORMATS', value: '6' },
      { label: 'RETENTION', value: 'MULTI-YEAR' },
      { label: 'SHEET', value: '07 OF 14' },
    ]}
  />

  <div class="stage-section">
    <Figure
      number={7}
      subject="THE CHAIN AN AUDITOR WALKS"
      caption="If the supplier's batch code is missing, the chain breaks at the first link — and the finding lands on the grower, not on the supplier."
      sheet={7}
    >
      <TraceabilityChainFigure />
    </Figure>
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.traceability.caption}
      columns={tables.traceability.columns}
      rows={tables.traceability.rows}
    />
  </div>

  <div class="stage-section">
    <NotesBlock>
      <p>
        Thermal stock is synthetic rather than paper because a paper label at 90 % relative humidity
        fails inside a week. Batch cards carry fixed fields for variety, rootstock, scion source,
        date, operator, treatment and QC observation. Logbooks are sequentially numbered and
        duplicate, so the copy stays in the house and the original goes to the file. Variable data —
        lot numbers, barcodes, QR codes — is subject to your printer and media.
      </p>
    </NotesBlock>
  </div>

  <div class="stage-section">
    <StageNav current="record" />
    <QuotationBlock />
  </div>
</BaseLayout>

<style>
  .stage-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--side-gutter) 0;
  }

  .stage-section:last-child {
    padding-bottom: var(--space-6);
  }
</style>
