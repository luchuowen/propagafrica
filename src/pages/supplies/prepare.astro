---
import BaseLayout from '../../layouts/BaseLayout.astro';
import trayFillingImg from '../../assets/images/tray-filling.jpg';
import Figure from '../../components/Figure.astro';
import PageHero from '../../components/PageHero.astro';
import SpecTable from '../../components/supplies/SpecTable.astro';
import NotesBlock from '../../components/supplies/NotesBlock.astro';
import StageNav from '../../components/supplies/StageNav.astro';
import QuotationBlock from '../../components/supplies/QuotationBlock.astro';
import CellSectionFigure from '../../assets/figures/supplies/cell-section.svg';
import { specTable } from '../../data/products/tables';

const tables = {
  vermiculite: specTable('vermiculite'),
  peat: specTable('peat'),
  trays: specTable('trays'),
};
---

<BaseLayout
  title="Prepare"
  description="What a young plant sits in decides how evenly it roots. A medium that holds a little too much water, or a tray filled a few millimetres short, shows up"
>
  <PageHero
    eyebrow="STAGE 01 · PREPARE"
    title="Growing media, trays and tools."
    standfirst="What a young plant sits in decides how evenly it roots. A medium that holds a little too much water, or a tray filled a few millimetres short, shows up three weeks later as a batch that finishes unevenly — long after anyone can do anything about it."
    image={trayFillingImg}
    imageAlt="A nursery worker filling black propagation trays with dark peat at a potting bench"
  />

  <div class="stage-section">
    <Figure
      number={3}
      subject="CELL SECTION, 128-CELL TRAY · SCALE 1:1.6"
      caption="Under-filling costs root volume. Over-filling closes the drainage path and waterlogs the base of the cell. Six millimetres of headspace is the working target."
      sheet={3}
    >
      <CellSectionFigure />
    </Figure>
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.vermiculite.caption}
      columns={tables.vermiculite.columns}
      rows={tables.vermiculite.rows}
    />
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.peat.caption}
      columns={tables.peat.columns}
      rows={tables.peat.rows}
    />
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.trays.caption}
      columns={tables.trays.columns}
      rows={tables.trays.rows}
    />
  </div>

  <div class="stage-section">
    <NotesBlock>
      <p>
        Vermiculite is exfoliated, supplied at 8 % moisture or below, cation exchange capacity
        80–150 meq/100 g. Peat is a sphagnum-based professional substrate; wetting agent and starter
        nutrition to the stated formulation. Conductivity measured on a 1:5 volume extract. A
        certificate of analysis is issued per batch. Grade selection depends on crop, tray and
        irrigation regime — tell us those and we will recommend rather than guess.
      </p>
    </NotesBlock>
  </div>

  <div class="stage-section">
    <StageNav current="prepare" />
    <QuotationBlock />
  </div>
</BaseLayout>

<style>
  .stage-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--side-gutter) 0;
  }

  .stage-section:last-child {
    padding-bottom: var(--space-6);
  }
</style>
