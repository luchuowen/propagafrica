---
import BaseLayout from '../../layouts/BaseLayout.astro';
import mistBenchImg from '../../assets/images/mist-bench.jpg';
import Figure from '../../components/Figure.astro';
import PageHero from '../../components/PageHero.astro';
import SpecTable from '../../components/supplies/SpecTable.astro';
import NotesBlock from '../../components/supplies/NotesBlock.astro';
import StageNav from '../../components/supplies/StageNav.astro';
import QuotationBlock from '../../components/supplies/QuotationBlock.astro';
import MistBenchFigure from '../../assets/figures/supplies/mist-bench.svg';
import { SPECIFIED_AND_SOURCED_CATEGORIES } from '../../data/products/root';
import { specTable } from '../../data/products/tables';

const tables = {
  monitoring: specTable('monitoring'),
};
---

<BaseLayout
  title="Root"
  description="A freshly grafted plant cannot drink yet, so the air around its leaves has to stay wet without the base of the cell ever sitting in water. Holding both at"
>
  <PageHero
    eyebrow="STAGE 03 · ROOT"
    title="Misting, benching, irrigation and monitoring."
    standfirst="A freshly grafted plant cannot drink yet, so the air around its leaves has to stay wet without the base of the cell ever sitting in water. Holding both at once, for three weeks, is the hardest thing a propagation house does."
    image={mistBenchImg}
    imageAlt="Overhead misting nozzles spraying a bench of young rose cuttings, backlit droplets in the air"
  />

  <div class="stage-section">
    <Figure
      number={5}
      subject="MIST BENCH, ELEVATION · SCALE 1:20"
      caption="The sensor belongs at canopy height, not at the gable. The two read differently, and the plant lives at the canopy."
      sheet={5}
    >
      <MistBenchFigure />
    </Figure>
  </div>

  <div class="stage-section">
    <h2>What we specify and source</h2>
    <p class="lede">
      Equipment at this stage is designed around your house and sourced to that design. It is not
      held in stock.
    </p>
    <ul class="category-list">
      {SPECIFIED_AND_SOURCED_CATEGORIES.map((category) => (
        <li>{category}</li>
      ))}
    </ul>
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.monitoring.caption}
      columns={tables.monitoring.columns}
      rows={tables.monitoring.rows}
    />
  </div>

  <div class="stage-section">
    <NotesBlock>
      <p>
        Moisture sensors are calibrated to the substrate actually in use — coco peat, a vermiculite
        blend and a peat formulation each read differently, and a sensor calibrated for one is wrong
        in another. Supplied as hardware, dashboard and support together, with threshold alerts and
        export of the full history.
      </p>
      <p>
        THIS IS THE ONE STAGE WHERE WE DESIGN BEFORE WE QUOTE. SEND US THE HOUSE DIMENSIONS AND THE
        CROP.
      </p>
    </NotesBlock>
  </div>

  <div class="stage-section">
    <StageNav current="root" />
    <QuotationBlock />
  </div>
</BaseLayout>

<style>
  .stage-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--side-gutter) 0;
  }

  .stage-section:last-child {
    padding-bottom: var(--space-6);
  }

  .lede {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    max-width: 46em;
  }

  .category-list {
    margin: var(--space-2) 0 0;
    padding-left: 1.2em;
    max-width: 46em;
  }

  .category-list li {
    margin-top: 6px;
  }
</style>
