---
import BaseLayout from '../../layouts/BaseLayout.astro';
import graftingHandsImg from '../../assets/images/grafting-hands.jpg';
import Figure from '../../components/Figure.astro';
import PageHero from '../../components/PageHero.astro';
import SpecTable from '../../components/supplies/SpecTable.astro';
import NotesBlock from '../../components/supplies/NotesBlock.astro';
import StageNav from '../../components/supplies/StageNav.astro';
import QuotationBlock from '../../components/supplies/QuotationBlock.astro';
import GraftElevationFigure from '../../assets/figures/supplies/graft-elevation.svg';
import SleeveSelector from '../../components/tools/SleeveSelector.astro';
import { specTable } from '../../data/products/tables';

const tables = {
  sleeves: specTable('sleeves'),
  clips: specTable('clips'),
};
---

<BaseLayout
  title="Graft"
  description="Two cut faces have to be brought into line and held there for weeks. The pressure has to be even and unchanging, and whatever holds them has to come away"
>
  <PageHero
    eyebrow="STAGE 02 · GRAFT"
    title="Grafting sleeves and clips."
    standfirst="Two cut faces have to be brought into line and held there for weeks. The pressure has to be even and unchanging, and whatever holds them has to come away without tearing tissue that is only days old."
    image={graftingHandsImg}
    imageAlt="A nursery worker pressing a freshly grafted rose cutting into a tray, a sleeve gripping the join"
  />

  <div class="stage-section">
    <Figure
      number={4}
      subject="SPLICE GRAFT IN A PRO-ROSE 45 SLEEVE · SCALE 2:1"
      caption="Choose the bore against the larger of scion and rootstock at the cut. A sleeve one size over slips and the join moves. One size under and it presses on the layer that has to grow."
      sheet={4}
    >
      <GraftElevationFigure />
    </Figure>
    <p class="sleeve-link">
      <a href="#find-the-right-sleeve">Find the right sleeve →</a>
    </p>
  </div>

  <div class="stage-section" id="find-the-right-sleeve">
    <h2>Find the right sleeve</h2>
    <SleeveSelector />
  </div>

  <div class="stage-section" id="sleeves">
    <SpecTable
      caption={tables.sleeves.caption}
      columns={tables.sleeves.columns}
      rows={tables.sleeves.rows}
    />
  </div>

  <div class="stage-section">
    <SpecTable
      caption={tables.clips.caption}
      columns={tables.clips.columns}
      rows={tables.clips.rows}
    />
  </div>

  <div class="stage-section">
    <NotesBlock>
      <p>
        Sleeves are platinum-cured silicone, transparent, Shore A 40 ± 5, light transmission 88 % or
        better so a join can be inspected without removing the sleeve. Service range −40 °C to +200
        °C, UV stable. Dimensional tolerance ± 0.15 mm on bore, held to batch. Single use.
      </p>
      <p>
        Grafted vegetables are cut at roughly 30° just above the seed leaves and secured with a clip
        or a flexible sleeve. In Kenya this is still an emerging practice rather than an established
        one — the documented work is a demonstration programme run by Egerton University with
        Nanjing Agricultural University across 18 sites in Nakuru, Kisumu, Bomet and Subukia. Rose
        and fruit-tree grafting are the established, repeat-volume operations.
      </p>
    </NotesBlock>
  </div>

  <div class="stage-section">
    <StageNav current="graft" />
    <QuotationBlock />
  </div>
</BaseLayout>

<style>
  .stage-section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-4) var(--side-gutter) 0;
  }

  .stage-section:last-child {
    padding-bottom: var(--space-6);
  }

  .sleeve-link {
    margin-top: var(--space-2);
    font-size: 14px;
  }

  .sleeve-link a {
    color: var(--green);
    text-decoration: none;
    font-weight: 600;
  }

  .sleeve-link a:hover {
    text-decoration: underline;
  }

  h2 {
    margin: 0 0 var(--space-3);
  }
</style>
