---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import { organizationJsonLd } from '../lib/seo';

const jsonLd = organizationJsonLd(Astro.site!);

// Hero carousel — blueprint.md Section 1. H1/sub-head/CTAs are a single
// overlay for the whole hero (not repeated per slide); each slide keeps its
// own caption from the copy deck.
const heroSlides = [
  {
    src: '/images/hero/hero-01.jpg',
    alt: 'Grafting tubes and clips in use on a rose propagation bench',
    caption: 'Grafting tubes and clips built for high-volume rose production',
  },
  {
    src: '/images/hero/hero-02.jpg',
    alt: 'Nursery consumables staged for a propagation batch',
    caption: 'Nursery consumables for clean, efficient propagation',
  },
  {
    src: '/images/hero/hero-03.jpg',
    alt: 'Climate and irrigation system installed in a commercial greenhouse',
    caption: 'Climate and irrigation systems designed and installed to your site',
  },
  {
    src: '/images/hero/hero-04.jpg',
    alt: 'Monitoring hardware mounted above a propagation bench, dashboard on a phone',
    caption: 'Monitoring hardware and dashboards that track graft success in real time',
  },
  {
    src: '/images/hero/hero-05.jpg',
    alt: 'A technical support visit on site at a nursery',
    caption: 'Technical support from setup to season one',
  },
];

// Propagation Journey — blueprint.md Section 1.
const journeySlides = [
  {
    src: '/images/process/process-01.jpg',
    alt: 'Rootstock and scion stock selected and prepared before grafting',
    caption: '1. Select and prepare stock',
  },
  {
    src: '/images/process/process-02.jpg',
    alt: 'A grafted union held together with a clip and silicone tube',
    caption: '2. Graft and clip the union',
  },
  {
    src: '/images/process/process-03.jpg',
    alt: 'Grafted cuttings rooting on a misted bench under controlled humidity',
    caption: '3. Root under controlled humidity',
  },
  {
    src: '/images/process/process-04.jpg',
    alt: 'A monitoring sensor logging temperature, humidity and VPD above a bench',
    caption: '4. Monitor temperature, humidity and VPD',
  },
  {
    src: '/images/process/process-05.jpg',
    alt: 'Rooted plants being hardened off and potted on',
    caption: '5. Harden off and pot on',
  },
  {
    src: '/images/process/process-06.jpg',
    alt: 'Finished young plants moved into production rows',
    caption: '6. Move to production',
  },
];

// Facilities-in-use — blueprint.md Section 1: generic regional settings, no
// named customers (none exist in the source material).
const facilitySlides = [
  {
    src: '/images/facility/facility-01.jpg',
    alt: 'Grafting tubes and clips in use during a rose propagation run',
    caption: 'Grafting tubes and clips in use during a rose propagation run, Naivasha region',
  },
  {
    src: '/images/facility/facility-02.jpg',
    alt: 'Nursery consumables staged for a vegetable seedling batch',
    caption: 'Nursery consumables staged for a vegetable seedling batch, central Kenya',
  },
  {
    src: '/images/facility/facility-03.jpg',
    alt: 'Misting system installed in a rose greenhouse',
    caption: 'Misting system installed in a rose greenhouse, Rift Valley region',
  },
  {
    src: '/images/facility/facility-04.jpg',
    alt: 'Drip irrigation running across a propagation block',
    caption: 'Drip irrigation running across a propagation block, Ethiopia',
  },
  {
    src: '/images/facility/facility-05.jpg',
    alt: 'A sanitation footbath at the entrance to a propagation house',
    caption: 'Sanitation station at the entrance to a propagation house, Kenya',
  },
  {
    src: '/images/facility/facility-06.jpg',
    alt: 'Monitoring sensors mounted above a mist bench',
    caption: 'Monitoring sensors mounted above a mist bench, tracking temperature and humidity',
  },
  {
    src: '/images/facility/facility-07.jpg',
    alt: 'Benching and racking fitted out for a new propagation block',
    caption: 'Benching and racking fitted out for a new propagation block, Kenya',
  },
  {
    src: '/images/facility/facility-08.jpg',
    alt: 'A technical support visit reviewing a propagation protocol on site',
    caption: 'Technical support reviewing a propagation protocol on site, Ethiopia',
  },
];

// Outcome panels — blueprint.md Section 1, exact headings and body copy.
const outcomes = [
  {
    n: '01',
    heading: 'Graft with confidence',
    body: 'Medical-grade silicone tubes and precision clips sized for roses, vegetables and fruit trees, so unions hold and take.',
  },
  {
    n: '02',
    heading: 'Grow without guesswork',
    body: 'Temperature, humidity, VPD and soil-moisture sensors feed a dashboard you can check from a phone, so problems are caught before they cost you a batch.',
  },
  {
    n: '03',
    heading: 'Scale without shortages',
    body: 'Local stock in Kenya and Ethiopia and bulk packaging built for commercial nurseries, not hobby growers.',
  },
];

// Product families — blueprint.md Sections 3-9. Descriptor is each family's
// verbatim intro line. Tags drive the shop-by-crop filter (Section 2: tubes
// and clips carry crop-specific tags; systems, sanitation, monitoring,
// services and nursery consumables are tagged "Nursery and facility supplies").
const CROP_ALL = 'All';
const CROP_TAGS = [
  'Roses and ornamentals',
  'Vegetables and cucurbits',
  'Fruit trees',
  'Nursery and facility supplies',
];

const families = [
  {
    slug: 'grafting-tubes',
    name: 'Grafting Tubes',
    descriptor:
      'High-quality silicone tubes designed for rose and ornamental as well as vegetable and fruit tree grafting. Ensure optimal union, high graft success and healthy growth.',
    tags: ['Roses and ornamentals', 'Vegetables and cucurbits', 'Fruit trees'],
    img: '/images/products/grafting-tubes/hero.jpg',
  },
  {
    slug: 'grafting-clips',
    name: 'Grafting Clips',
    descriptor: 'Precision clips for strong graft unions and better propagation outcomes.',
    tags: ['Roses and ornamentals', 'Vegetables and cucurbits', 'Fruit trees'],
    img: '/images/products/grafting-clips/hero.jpg',
  },
  {
    slug: 'nursery-consumables',
    name: 'Nursery Consumables',
    descriptor: 'Essential supplies for clean, efficient and productive nurseries.',
    tags: ['Nursery and facility supplies'],
    img: '/images/products/nursery-consumables/hero.jpg',
  },
  {
    slug: 'propagation-systems',
    name: 'Propagation Systems',
    descriptor: 'Integrated systems to improve efficiency, uniformity and yield.',
    tags: ['Nursery and facility supplies'],
    img: '/images/products/propagation-systems/hero.jpg',
  },
  {
    slug: 'sanitation',
    name: 'Sanitation Products',
    descriptor:
      'Disinfectants, sanitizers and hygiene solutions for a disease-free propagation environment.',
    tags: ['Nursery and facility supplies'],
    img: '/images/products/sanitation/hero.jpg',
  },
  {
    slug: 'monitoring',
    name: 'Propagation Monitoring',
    descriptor: 'Digital tools to track, manage and improve your propagation results.',
    tags: ['Nursery and facility supplies'],
    img: '/images/products/monitoring/hero.jpg',
  },
  {
    slug: 'technical-services',
    name: 'Technical Services',
    descriptor: 'From training to troubleshooting, we support your propagation journey.',
    tags: ['Nursery and facility supplies'],
    img: '/images/products/technical-services/hero.jpg',
  },
];

// Services 3-up — blueprint.md Section 9, first three "Our Services" bullets.
const services = [
  'Propagation training and workshops',
  'On-site technical support',
  'Nursery setup and design',
];

// Product Reference — verbatim lists, reused everywhere.
const trustList = [
  'High-quality, reliable products',
  'Competitive pricing and bulk supply',
  'Technical expertise and support',
  'Customised solutions',
  'Consistent availability',
  'Strong relationships with global manufacturers',
  'Local stock in Kenya and Ethiopia',
];

const targetMarkets = [
  'Commercial flower growers',
  'Vegetable and fruit growers',
  'Nurseries and propagation labs',
  'Agri-businesses and distributors',
  'Research and training institutions',
];
---

<BaseLayout
  title="Propagation supplies for nurseries and flower farms across Kenya and Ethiopia"
  description="PropagAfrica Technologies supplies the grafting tubes, clips, nursery consumables, propagation systems, sanitation products and monitoring tools that commercial growers depend on, with technical support and stock held in both countries."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <Carousel slides={heroSlides} label="Featured product ranges" variant="hero" />
    <div class="hero-copy">
      <div class="hero-copy-inner">
        <p class="eyebrow light">Propagation inputs and systems, East Africa</p>
        <h1>Propagation supplies for nurseries and flower farms across Kenya and Ethiopia</h1>
        <p class="hero-sub">
          PropagAfrica Technologies supplies the grafting tubes, clips, nursery consumables,
          propagation systems, sanitation products and monitoring tools that commercial growers
          depend on, with technical support and stock held in both countries.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact/">
            Request a Quotation
          </a>
          <a class="btn btn-ghost" href="/products/">
            Browse products
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Outcome panels -->
  <section class="outcomes">
    <div class="outcomes-inner">
      {outcomes.map((o) => (
        <div class="outcome">
          <span class="outcome-n">{o.n}</span>
          <h2>{o.heading}</h2>
          <p>{o.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Propagation Journey -->
  <section class="journey">
    <div class="journey-inner">
      <div class="section-head">
        <p class="eyebrow">The propagation journey</p>
        <h2>From selected stock to finished plant</h2>
      </div>
      <Carousel slides={journeySlides} label="The propagation journey" variant="grid" />
    </div>
  </section>

  <!-- Product grid teaser -->
  <section class="products">
    <div class="products-inner">
      <div class="section-head">
        <p class="eyebrow">Full range</p>
        <h2>Everything a propagation nursery runs on</h2>
      </div>

      <div class="filter-pills" role="group" aria-label="Filter products by what you grow">
        <button type="button" class="pill is-active" data-tag={CROP_ALL}>
          All
        </button>
        {CROP_TAGS.map((tag) => (
          <button type="button" class="pill" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <ul class="product-grid" data-product-grid>
        {families.map((f) => (
          <li class="product-card" data-tags={f.tags.join('|')}>
            <div class="product-media">
              <img src={f.img} alt="" loading="lazy" />
            </div>
            <div class="product-body">
              <h3>
                <a href={`/products/${f.slug}/`}>{f.name}</a>
              </h3>
              <p>{f.descriptor}</p>
              <a class="link-arrow" href={`/products/${f.slug}/`}>
                View range &rarr;
              </a>
            </div>
          </li>
        ))}
      </ul>
      <p class="filter-empty" data-filter-empty hidden>
        No product families match that filter.
      </p>
    </div>
  </section>

  <!-- Facilities-in-use -->
  <section class="facilities">
    <div class="facilities-inner">
      <div class="section-head">
        <p class="eyebrow">In the field</p>
        <h2>Facilities in use across Kenya and Ethiopia</h2>
      </div>
      <Carousel slides={facilitySlides} label="Facilities in use" variant="grid" />
    </div>
  </section>

  <!-- Monitoring spotlight -->
  <section class="monitoring">
    <div class="monitoring-inner">
      <div class="monitoring-copy">
        <p class="eyebrow light">PropagAfrica Monitoring</p>
        <h2>See what&rsquo;s happening in your nursery, not just what happened last week.</h2>
        <p class="monitoring-body">
          PropagAfrica Monitoring pairs temperature, humidity, VPD, soil-moisture, EC and PAR
          sensors with a mobile and web dashboard, alerts and historical reporting &mdash; hardware,
          software and support in one package.
        </p>
        <dl class="readings">
          <div>
            <dt>Example reading</dt>
            <dd>Graft Success 98.4%</dd>
          </div>
          <div>
            <dt>Example reading</dt>
            <dd>Average zone temperature 24.6&deg;C</dd>
          </div>
        </dl>
        <a class="link-arrow light" href="/products/monitoring/">
          See Propagation Monitoring &rarr;
        </a>
      </div>
      <div class="monitoring-media">
        <img
          src="/images/products/monitoring/dashboard.png"
          alt="PropagAfrica Monitoring dashboard showing temperature, humidity and VPD readings"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Services 3-up -->
  <section class="services">
    <div class="services-inner">
      <div class="section-head">
        <p class="eyebrow">Technical Services</p>
        <h2>Expert support. Lasting success.</h2>
      </div>
      <ul class="services-grid">
        {services.map((s, i) => (
          <li class="service">
            <span class="service-n">{String(i + 1).padStart(2, '0')}</span>
            <a href="/products/technical-services/">{s}</a>
          </li>
        ))}
      </ul>
      <a class="link-arrow" href="/products/technical-services/">
        See all Technical Services &rarr;
      </a>
    </div>
  </section>

  <!-- Trust + target markets -->
  <section class="trust">
    <div class="trust-inner">
      <div class="trust-col">
        <h2>Why partner with PropagAfrica</h2>
        <ul class="check-list">
          {trustList.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="trust-col">
        <h2>Who we supply</h2>
        <ul class="check-list">
          {targetMarkets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="cta-band-inner">
      <h2>Tell us what you&rsquo;re growing and how much of it.</h2>
      <p>
        Send your crop, volume and site details and we&rsquo;ll come back with the right products
        and packaging.
      </p>
      <a class="btn btn-primary" href="/contact/">
        Request a Quotation
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-pills .pill'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const tag = pill.dataset.tag ?? 'All';
      pills.forEach((p) => p.classList.toggle('is-active', p === pill));

      let visibleCount = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split('|');
        const matches = tag === 'All' || tags.includes(tag);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      if (grid) grid.hidden = visibleCount === 0;
      if (empty) empty.hidden = visibleCount !== 0;
    });
  });
</script>

<style>
  /* ---------- eyebrow variant ---------- */
  .eyebrow.light {
    color: var(--paper);
    opacity: 0.85;
  }

  .section-head {
    max-width: 62ch;
    margin-bottom: var(--space-4);
  }

  .section-head h2 {
    margin-top: var(--space-1);
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink-overlay-strong);
    z-index: -1;
  }

  .hero-copy-inner {
    max-width: var(--wide-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter);
    pointer-events: auto;
  }

  .hero-copy h1 {
    margin-top: var(--space-2);
    color: var(--paper);
    max-width: 20ch;
  }

  .hero-sub {
    margin-top: var(--space-3);
    font-size: 16px;
    line-height: 1.6;
    color: var(--paper);
    opacity: 0.92;
    max-width: 52ch;
  }

  @media (min-width: 820px) {
    .hero-copy-inner {
      max-width: 640px;
    }
  }

  .hero-actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ---------- buttons ---------- */
  .btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 11px 22px;
    border-radius: var(--radius-s);
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--green);
    color: var(--paper);
    border-color: var(--green);
  }

  .btn-primary:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
  }

  .btn-ghost {
    color: var(--paper);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .btn-ghost:hover {
    border-color: var(--paper);
  }

  /* ---------- outcome panels ---------- */
  .outcomes {
    border-bottom: 1px solid var(--rule);
  }

  .outcomes-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter);
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 820px) {
    .outcomes-inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .outcome {
    border-top: 1px solid var(--ink);
    padding-top: var(--space-2);
  }

  .outcome-n {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--soft);
  }

  .outcome h2 {
    margin-top: var(--space-2);
  }

  .outcome p {
    margin-top: var(--space-2);
    font-size: 15px;
    line-height: 1.65;
    color: var(--soft);
  }

  /* ---------- propagation journey ---------- */
  .journey {
    padding: var(--space-6) 0;
    background: var(--mint);
  }

  .journey-inner,
  .products-inner,
  .facilities-inner,
  .services-inner,
  .trust-inner,
  .monitoring-inner,
  .cta-band-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  /* ---------- product grid teaser ---------- */
  .products {
    padding: var(--space-6) 0;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .pill {
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .pill:hover {
    border-color: var(--green);
  }

  .pill.is-active {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
  }

  .product-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
  }

  .product-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mint);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-body {
    padding: var(--space-3);
  }

  .product-body h3 {
    font-size: 18px;
  }

  .product-body h3 a {
    text-decoration: none;
  }

  .product-body h3 a:hover {
    text-decoration: underline;
  }

  .product-body p {
    margin-top: var(--space-2);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--soft);
  }

  .filter-empty {
    margin-top: var(--space-4);
    color: var(--soft);
    font-size: 15px;
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }

  .link-arrow.light {
    color: var(--paper);
  }

  /* ---------- facilities ---------- */
  .facilities {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
  }

  /* ---------- monitoring spotlight ---------- */
  .monitoring {
    background: var(--green-dark);
    color: var(--paper);
    padding: var(--space-6) 0;
  }

  .monitoring-inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 900px) {
    .monitoring-inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-6);
    }
  }

  .monitoring h2 {
    margin-top: var(--space-2);
    color: var(--paper);
    max-width: 22ch;
  }

  .monitoring-body {
    margin-top: var(--space-3);
    font-size: 15px;
    line-height: 1.7;
    color: var(--paper);
    opacity: 0.88;
    max-width: 52ch;
  }

  .readings {
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .readings > div {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    padding-top: var(--space-2);
  }

  .readings dt {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.68;
  }

  .readings dd {
    margin: 2px 0 0;
    font-family: var(--f-mono);
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    color: var(--paper);
  }

  .monitoring-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-m);
  }

  /* ---------- services 3-up ---------- */
  .services {
    padding: var(--space-6) 0;
  }

  .services-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service {
    border-top: 1px solid var(--ink);
    padding-top: var(--space-2);
  }

  .service-n {
    display: block;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--soft);
  }

  .service a {
    display: block;
    margin-top: var(--space-1);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
  }

  .service a:hover {
    text-decoration: underline;
  }

  /* ---------- trust + target markets ---------- */
  .trust {
