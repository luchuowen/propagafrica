---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import JourneySteps from '../components/home/JourneySteps.astro';
import TrustPanel from '../components/TrustPanel.astro';
import { organizationJsonLd } from '../lib/seo';
import { PRODUCT_FAMILIES, CROP_ALL, CROP_TAGS } from '../data/products/families';

const jsonLd = organizationJsonLd(Astro.site!);

// Hero carousel — blueprint.md Section 1. H1/sub-head/CTAs are a single
// overlay for the whole hero (not repeated per slide); each slide keeps its
// own caption from the copy deck.
const heroSlides = [
  {
    src: '/images/hero/hero-01.jpg',
    alt: 'Grafting tubes and clips in use on a rose propagation bench',
  },
  {
    src: '/images/hero/hero-02.jpg',
    alt: 'Nursery consumables staged for a propagation batch',
  },
  {
    src: '/images/hero/hero-03.jpg',
    alt: 'Climate and irrigation system installed in a commercial greenhouse',
  },
  {
    src: '/images/hero/hero-04.jpg',
    alt: 'Monitoring hardware mounted above a propagation bench, dashboard on a phone',
  },
  {
    src: '/images/hero/hero-05.jpg',
    alt: 'A technical support visit on site at a nursery',
  },
];

// Propagation Journey — blueprint.md Section 1.
const journeySlides = [
  {
    src: '/images/process/process-01.jpg',
    alt: 'Rootstock and scion stock selected and prepared before grafting',
    step: '1',
    caption: 'Select and prepare stock',
  },
  {
    src: '/images/process/process-02.jpg',
    alt: 'A grafted union held together with a clip and silicone tube',
    step: '2',
    caption: 'Graft and clip the union',
  },
  {
    src: '/images/process/process-03.jpg',
    alt: 'Grafted cuttings rooting on a misted bench under controlled humidity',
    step: '3',
    caption: 'Root under controlled humidity',
  },
  {
    src: '/images/process/process-04.jpg',
    alt: 'A monitoring sensor logging temperature, humidity and VPD above a bench',
    step: '4',
    caption: 'Monitor temperature, humidity and VPD',
  },
  {
    src: '/images/process/process-05.jpg',
    alt: 'Rooted plants being hardened off and potted on',
    step: '5',
    caption: 'Harden off and pot on',
  },
  {
    src: '/images/process/process-06.jpg',
    alt: 'Finished young plants moved into production rows',
    step: '6',
    caption: 'Move to production',
  },
];

// Facilities-in-use — blueprint.md Section 1: generic regional settings, no
// named customers (none exist in the source material).
const facilitySlides = [
  {
    src: '/images/facility/facility-01.jpg',
    alt: 'Grafting tubes and clips in use during a rose propagation run',
    caption: 'Grafting tubes and clips in use during a rose propagation run, Naivasha region',
  },
  {
    src: '/images/facility/facility-02.jpg',
    alt: 'Nursery consumables staged for a vegetable seedling batch',
    caption: 'Nursery consumables staged for a vegetable seedling batch, central Kenya',
  },
  {
    src: '/images/facility/facility-03.jpg',
    alt: 'Misting system installed in a rose greenhouse',
    caption: 'Misting system installed in a rose greenhouse, Rift Valley region',
  },
  {
    src: '/images/facility/facility-04.jpg',
    alt: 'Drip irrigation running across a propagation block',
    caption: 'Drip irrigation running across a propagation block, Ethiopia',
  },
  {
    src: '/images/facility/facility-05.jpg',
    alt: 'A sanitation footbath at the entrance to a propagation house',
    caption: 'Sanitation station at the entrance to a propagation house, Kenya',
  },
  {
    src: '/images/facility/facility-06.jpg',
    alt: 'Monitoring sensors mounted above a mist bench',
    caption: 'Monitoring sensors mounted above a mist bench, tracking temperature and humidity',
  },
  {
    src: '/images/facility/facility-07.jpg',
    alt: 'Benching and racking fitted out for a new propagation block',
    caption: 'Benching and racking fitted out for a new propagation block, Kenya',
  },
  {
    src: '/images/facility/facility-08.jpg',
    alt: 'A technical support visit reviewing a propagation protocol on site',
    caption: 'Technical support reviewing a propagation protocol on site, Ethiopia',
  },
];

// Outcome panels — blueprint.md Section 1, exact headings and body copy.
const outcomes = [
  {
    n: '01',
    heading: 'Graft with confidence',
    body: 'Medical-grade silicone tubes and precision clips sized for roses, vegetables and fruit trees, so unions hold and take.',
  },
  {
    n: '02',
    heading: 'Grow without guesswork',
    body: 'Temperature, humidity, VPD and soil-moisture sensors feed a dashboard you can check from a phone, so problems are caught before they cost you a batch.',
  },
  {
    n: '03',
    heading: 'Scale without shortages',
    body: 'Regional stock hubs in Kenya and Ethiopia and bulk packaging built for commercial nurseries, not hobby growers.',
  },
];

// Product families — blueprint.md Sections 3-9, imported from the shared
// registry (src/data/products/families.ts) so the homepage teaser and the
// /products/ hub can never disagree on a name, tagline or tag.
// The homepage teaser shows only the six physical-goods families so the
// grid divides evenly with no dead space; Technical Services (a service,
// not a stocked product) still appears in full on /products/.
const families = PRODUCT_FAMILIES.filter((f) => f.slug !== 'technical-services');

// Services 3-up — blueprint.md Section 9, first three "Our Services" bullets.
// `short` only differs from `full` where the full line wraps to two lines on
// a phone while its siblings sit on one — a mobile-only display swap, not a
// reword of the locked copy, which still ships in full for desktop.
const services = [
  { full: 'Propagation training and workshops', short: 'Propagation training' },
  { full: 'On-site technical support', short: 'On-site technical support' },
  { full: 'Nursery setup and design', short: 'Nursery setup and design' },
];
---

<BaseLayout
  title="Propagation supplies for nurseries and flower farms across Africa"
  description="PropagAfrica Technologies supplies the grafting tubes, clips, nursery consumables, propagation systems, sanitation products and monitoring tools that commercial growers across Africa depend on, with technical support and regional stock hubs in Kenya and Ethiopia."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <Carousel slides={heroSlides} label="Featured product ranges" variant="hero" />
    <div class="hero-copy">
      <div class="hero-copy-inner">
        <h1>Propagation supplies for nurseries and flower farms across Africa</h1>
        <!-- blueprint.md Section 1 sub-head is locked, verbatim copy — kept in full for
             desktop. The mobile-only line below is a condensed reading of the same
             sentence, not a rewrite, swapped in purely by CSS so the full copy still
             ships to every viewport. -->
        <p class="hero-sub hero-sub-full">
          PropagAfrica Technologies supplies the grafting tubes, clips, nursery consumables,
          propagation systems, sanitation products and monitoring tools that commercial growers
          across Africa depend on, with technical support and regional stock hubs in Kenya and
          Ethiopia.
        </p>
        <p class="hero-sub hero-sub-short">
          Grafting supplies, nursery consumables and monitoring tools for growers across Africa,
          with regional stock hubs in Kenya and Ethiopia.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact/">
            Request a Quotation
          </a>
          <a class="btn btn-ghost" href="/products/">
            Browse products
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Outcome panels -->
  <section class="outcomes">
    <div class="outcomes-inner" data-reveal-group>
      {outcomes.map((o) => (
        <div class="outcome" data-reveal>
          <span class="outcome-n">{o.n}</span>
          <h2>{o.heading}</h2>
          <p>{o.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Propagation Journey -->
  <section class="journey">
    <div class="journey-inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow">The propagation journey</p>
        <h2>From selected stock to finished plant</h2>
      </div>
    </div>
    <JourneySteps steps={journeySlides} />
  </section>

  <!-- Product grid teaser -->
  <section class="products">
    <div class="products-inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Full range</p>
        <h2>Everything a propagation nursery runs on</h2>
      </div>

      <div class="filter-pills" role="group" aria-label="Filter products by what you grow">
        <button type="button" class="pill is-active" data-tag={CROP_ALL}>
          All
        </button>
        {CROP_TAGS.map((tag) => (
          <button type="button" class="pill" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <ul class="product-grid" data-product-grid data-reveal-group>
        {families.map((f) => (
          <li class="product-card" data-product-card data-tags={f.tags.join('|')} data-reveal>
            <div class="product-media">
              <img src={f.img} alt="" loading="lazy" />
            </div>
            <div class="product-body">
              <h3>
                <a href={f.href}>{f.name}</a>
              </h3>
              <p class="product-descriptor">{f.descriptor}</p>
              <span class="product-foot">
                <span>View range</span>
                <span class="product-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </div>
          </li>
        ))}
      </ul>
      <p class="filter-empty" data-filter-empty hidden>
        No product families match that filter.
      </p>
    </div>
  </section>

  <!-- Facilities-in-use -->
  <section class="facilities">
    <div class="facilities-inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow">In the field</p>
        <h2>Facilities in use across Kenya and Ethiopia</h2>
      </div>
      <Carousel slides={facilitySlides} label="Facilities in use" variant="grid" />
    </div>
  </section>

  <!-- Monitoring spotlight -->
  <section class="monitoring">
    <div class="monitoring-inner">
      <div class="monitoring-copy" data-reveal>
        <p class="eyebrow light">PropagAfrica Monitoring</p>
        <h2>See what&rsquo;s happening in your nursery, not just what happened last week.</h2>
        <p class="monitoring-body">
          PropagAfrica Monitoring pairs temperature, humidity, VPD, soil-moisture, EC and PAR
          sensors with a mobile and web dashboard, alerts and historical reporting &mdash; hardware,
          software and support in one package.
        </p>
        <dl class="readings">
          <div>
            <dt>Example reading</dt>
            <dd>Graft Success 98.4%</dd>
          </div>
          <div>
            <dt>Example reading</dt>
            <dd>Average zone temp 24.6&deg;C</dd>
          </div>
        </dl>
        <a class="btn btn-on-dark" href="/products/monitoring/">
          See Propagation Monitoring
          <span class="btn-arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
      <div class="monitoring-media" data-reveal style="--reveal-delay: 120ms">
        <img
          src="/images/products/monitoring/dashboard.png"
          alt="PropagAfrica Monitoring dashboard showing temperature, humidity and VPD readings"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Services 3-up -->
  <section class="services">
    <div class="services-inner">
      <figure class="services-fig" data-reveal>
        <img
          src="/images/products/technical-services/01.jpg"
          alt="A PropagAfrica technical team member training nursery staff at a propagation block"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="services-body">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Technical Services</p>
          <h2>Expert support. Lasting success.</h2>
        </div>
        <p class="services-intro" data-reveal style="--reveal-delay: 60ms">
          From training to troubleshooting, we support your propagation journey.
        </p>
        <ul class="services-list" data-reveal-group>
          {services.map((s, i) => (
            <li class="service" data-reveal>
              <a class="service-row" href="/products/technical-services/">
                <span class="service-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="service-title">
                  <span class="service-title-full">{s.full}</span>
                  <span class="service-title-short">{s.short}</span>
                </span>
                <span class="service-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn-primary services-all" href="/products/technical-services/">
          See all Technical Services
          <span class="btn-arrow" aria-hidden="true">
            &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust + target markets -->
  <TrustPanel />

  <!-- CTA band -->
  <section class="cta-band">
    <div class="cta-band-inner" data-reveal>
      <h2>What are you growing, and in what quantity?</h2>
      <p>
        Send your crop, volume and site details and we&rsquo;ll come back with the right products
        and packaging.
      </p>
      <a class="btn btn-primary" href="/contact/">
        Request a Quotation
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import { initProductFilter } from '../lib/product-filter';
  initProductFilter();
</script>

<style>
  .section-head {
    max-width: 62ch;
    margin-bottom: var(--space-4);
  }

  .section-head h2 {
    margin-top: var(--space-1);
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink-overlay-strong);
    z-index: -1;
  }

  .hero-copy-inner {
    width: 100%;
    max-width: var(--wide-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter);
    pointer-events: auto;
  }

  .hero-copy h1 {
    color: var(--paper);
    max-width: 27ch;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-sub {
    margin-top: var(--space-3);
    margin-left: auto;
    margin-right: auto;
    font-size: 16px;
    line-height: 1.6;
    color: var(--paper);
    opacity: 0.92;
    max-width: 60ch;
  }

  @media (min-width: 820px) {
    .hero-copy-inner {
      max-width: 760px;
    }
  }

  .hero-sub-short {
    display: none;
  }

  @media (max-width: 640px) {
    .hero-sub-full {
      display: none;
    }

    .hero-sub-short {
      display: block;
    }
  }

  .hero-actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  /* ---------- buttons ---------- */
  .btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 11px 22px;
    border-radius: var(--radius-s);
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--green);
    color: var(--paper);
    border-color: var(--green);
  }

  .btn-primary:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
  }

  .btn-ghost {
    color: var(--paper);
    border-color: rgba(255, 255, 255, 0.55);
  }

  /* The solid counterpart to .btn-primary, for the dark sections: on
     --green-dark a green fill disappears, so the paper takes the fill and the
     green becomes the ink. */
  .btn-on-dark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--paper);
    color: var(--green-dark);
    border-color: var(--paper);
  }

  .btn-on-dark:hover {
    background: var(--mint);
    border-color: var(--mint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn-arrow {
      transition: transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    .btn:hover .btn-arrow {
      transform: translateX(3px);
    }
  }

  .btn-ghost:hover {
    border-color: var(--paper);
  }

  /* ---------- outcome panels ---------- */
  .outcomes-inner {
    display: grid;
    gap: 0;
  }

  @media (min-width: 820px) {
    .outcomes-inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .outcome {
    padding: var(--space-4) var(--side-gutter);
  }

  @media (min-width: 820px) {
    .outcome {
      padding: var(--space-4) var(--space-4);
    }
  }

  .outcome:nth-child(1) {
    background: var(--green);
    color: var(--paper);
  }

  .outcome:nth-child(2) {
    /* Paper text on bare --terra is 4.24:1 — just under AA for the 15px body
       copy in this panel. Taking the ground a shade deeper (the hue is
       unchanged) clears 4.5:1 without touching the brand token, which is
       used as an accent elsewhere and must stay as it is. */
    background: color-mix(in srgb, var(--terra) 94%, var(--ink));
    color: var(--paper);
  }

  .outcome:nth-child(3) {
    background: var(--gold);
    color: var(--ink);
  }

  .outcome-n {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* Full opacity: at 0.85 this 11px numeral dropped to 3.5:1 on the terra
       panel. It is text, so it carries the panel's full text colour. */
  }

  .outcome h2 {
    margin-top: var(--space-2);
    color: inherit;
  }

  .outcome p {
    margin-top: var(--space-2);
    font-size: 15px;
    line-height: 1.65;
    color: inherit;
    /* Full opacity, like the numeral above: at 0.92 this 15px copy landed at
       4.14:1 on the terra panel, under AA. */
    max-width: 34ch;
  }

  /* ---------- propagation journey ---------- */
  .journey {
    padding: var(--space-6) 0;
    background: var(--mint);
  }

  .journey-inner,
  .products-inner,
  .facilities-inner,
  .services-inner,
  .monitoring-inner,
  .cta-band-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  /* ---------- product grid teaser ---------- */
  .products {
    padding: var(--space-6) 0;
    background: var(--white);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .pill {
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }

  .pill:hover {
    border-color: var(--green);
  }

  .pill.is-active {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
  }

  .product-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* A white mount with the photograph inset on it, rather than a beige block
     with the photograph bled to its edge. The card is the quiet part; the
     photograph and the green CTA carry the weight. */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    padding: 10px;
    background: var(--white);
  }

  .product-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--mint);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-card {
      transition:
        transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1),
        box-shadow 300ms ease;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-soft);
    }

    .product-media img {
      transition: transform 600ms ease;
    }

    .product-card:hover .product-media img {
      transform: scale(1.04);
    }

    .product-arrow {
      transition:
        background-color 300ms ease,
        border-color 300ms ease,
        color 300ms ease,
        transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    .product-card:hover .product-arrow {
      transform: translateX(3px);
    }
  }

  .product-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3) 14px 14px;
    text-align: center;
  }

  .product-body h3 {
    font-size: 21px;
    letter-spacing: -0.022em;
    line-height: 1.2;
  }

  .product-body h3 a {
    text-decoration: none;
  }

  /* The whole card is the target; the heading link carries the accessible
     name and the focus ring. */
  .product-body h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }

  .product-descriptor {
    margin-top: var(--space-2);
    font-size: 15px;
    line-height: 1.6;
    color: var(--soft);
  }

  /* Pinned to the bottom of the card so every "View range" in the row lines
     up, whatever the descriptor does. */
  .product-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
  }

  .product-arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--green);
  }

  .product-card:hover .product-arrow {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }

  .filter-empty {
    margin-top: var(--space-4);
    color: var(--soft);
    font-size: 15px;
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }

  .link-arrow.light {
    color: var(--paper);
  }

  /* ---------- facilities ---------- */
  /* A tonal ground (the same tint used elsewhere as the site's one "cool"
     background) instead of plain paper, so the photo cards read as cards
     floating on a surface rather than blending into the page background. */
  .facilities {
    padding: var(--space-6) 0;
    background: var(--green-pale);
  }

  /* ---------- monitoring spotlight ---------- */
  .monitoring {
    background: var(--green-dark);
    color: var(--paper);
    padding: var(--space-6) 0;
  }

  .monitoring-inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 900px) {
    .monitoring-inner {
      grid-template-columns: 1.1fr 0.9fr;
