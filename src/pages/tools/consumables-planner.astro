---
// Nursery Consumables Planner — blueprint.md Section 10 and the Build
// Workbook's Calculator Logic section. Client-side only: there is no server
// to compute against (this site builds to static HTML), so the interactive
// form stays `hidden` until the enhancement script proves JavaScript is
// running, and a <noscript> fallback points to /contact/ instead.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIntro from '../../components/tools/ToolIntro.astro';
import { TOOLS_DISCLAIMER } from '../../data/tools';
import { CELL_COUNTS } from '../../lib/tools/consumables-planner';
---

<BaseLayout
  title="Nursery Consumables Planner"
  description="Work out trays, pots, labels, domes and ties for your next propagation batch, with a wastage allowance you can adjust."
>
  <section class="tool-page">
    <div class="tool-inner">
      <ToolIntro
        eyebrow="Planning tools"
        title="Nursery Consumables Planner"
        sub="Work out trays, pots, labels, domes and ties for your next propagation batch."
        image="/images/products/nursery-consumables/hero.jpg"
        imageAlt="Propagation trays and nursery consumables ready for a new batch"
        howItWorks="Enter the number of cuttings or seedlings you're propagating and your tray cell count. The planner works out how many trays, pots, labels, humidity domes and ties you'll need for the batch, including a wastage allowance you can adjust and a few yes/no questions that add or remove items from the list."
      />

      <noscript>
        <p class="js-required">
          This planner needs JavaScript to run. <a href="/contact/">Request a Quotation</a> and our
          team will help you work out quantities.
        </p>
      </noscript>

      <div class="calculator" data-calculator hidden>
        <div class="form-panel">
          <p class="panel-label">Your propagation batch</p>
          <form id="consumables-form" novalidate>
            <div class="field">
              <label for="cuttings">Cuttings/seedlings to propagate</label>
              <input
                id="cuttings"
                name="cuttings"
                type="number"
                min="1"
                step="1"
                inputmode="numeric"
                placeholder="e.g. 10000"
              />
            </div>

            <div class="field">
              <label for="cell-count">Tray cell count</label>
              <select id="cell-count" name="cellCount">
                {CELL_COUNTS.map((count) => (
                  <option value={count}>{count} cells</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="buffer">Wastage buffer (%)</label>
              <input id="buffer" name="buffer" type="number" min="0" max="25" step="1" value="10" />
            </div>

            <div class="toggle-group">
              <label class="toggle">
                <input id="potting-on" name="pottingOn" type="checkbox" />
                <span>Potting-on stage</span>
              </label>
              <label class="toggle">
                <input id="humidity-domes" name="humidityDomes" type="checkbox" />
                <span>Humidity domes</span>
              </label>
              <label class="toggle">
                <input id="staked" name="staked" type="checkbox" />
                <span>Staked/trellised crop</span>
              </label>
            </div>
          </form>
        </div>

        <div class="results-panel">
          <p class="panel-label">Your quantities</p>
          <p class="hint" data-hint>
            Enter the number of cuttings or seedlings to propagate to see quantities.
          </p>
          <dl class="stat-grid" data-result-list hidden>
            <div class="stat-tile" data-row-trays hidden>
              <dt>Trays</dt>
              <dd class="mono" data-trays></dd>
            </div>
            <div class="stat-tile" data-row-pots hidden>
              <dt>Pots</dt>
              <dd class="mono" data-pots></dd>
            </div>
            <div class="stat-tile" data-row-labels hidden>
              <dt>Labels</dt>
              <dd class="mono" data-labels></dd>
            </div>
            <div class="stat-tile" data-row-domes hidden>
              <dt>Domes</dt>
              <dd class="mono" data-domes></dd>
            </div>
            <div class="stat-tile" data-row-ties hidden>
              <dt>Ties</dt>
              <dd class="mono" data-ties></dd>
            </div>
          </dl>

          <a class="btn-primary" id="quote-link" href="/contact/" data-result-list hidden>
            Request a Quotation
            <span class="btn-arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>

          <p class="disclaimer" data-result-list hidden>
            {TOOLS_DISCLAIMER}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { computeConsumablesPlan } from '../../lib/tools/consumables-planner';
  import { buildQuotationHref } from '../../lib/tools/handoff';

  const calculator = document.querySelector<HTMLElement>('[data-calculator]');
  const form = document.getElementById('consumables-form') as HTMLFormElement | null;
  if (calculator && form) {
    calculator.hidden = false;

    const cuttingsEl = document.getElementById('cuttings') as HTMLInputElement;
    const cellCountEl = document.getElementById('cell-count') as HTMLSelectElement;
    const pottingOnEl = document.getElementById('potting-on') as HTMLInputElement;
    const domesEl = document.getElementById('humidity-domes') as HTMLInputElement;
    const stakedEl = document.getElementById('staked') as HTMLInputElement;
    const bufferEl = document.getElementById('buffer') as HTMLInputElement;

    const hint = document.querySelector('[data-hint]') as HTMLElement;
    const resultEls = document.querySelectorAll<HTMLElement>('[data-result-list]');
    const traysOut = document.querySelector('[data-trays]') as HTMLElement;
    const potsOut = document.querySelector('[data-pots]') as HTMLElement;
    const labelsOut = document.querySelector('[data-labels]') as HTMLElement;
    const domesOut = document.querySelector('[data-domes]') as HTMLElement;
    const tiesOut = document.querySelector('[data-ties]') as HTMLElement;
    const rowTrays = document.querySelector('[data-row-trays]') as HTMLElement;
    const rowPots = document.querySelector('[data-row-pots]') as HTMLElement;
    const rowLabels = document.querySelector('[data-row-labels]') as HTMLElement;
    const rowDomes = document.querySelector('[data-row-domes]') as HTMLElement;
    const rowTies = document.querySelector('[data-row-ties]') as HTMLElement;
    const quoteLink = document.getElementById('quote-link') as HTMLAnchorElement;

    function isYes(checkbox: HTMLInputElement): boolean {
      return checkbox.checked;
    }

    function readBuffer(): number {
      const raw = Number(bufferEl.value);
      const value = Number.isFinite(raw) ? raw : 10;
      return Math.min(25, Math.max(0, value));
    }

    function showRow(row: HTMLElement, out: HTMLElement, value: number): void {
      row.hidden = value <= 0;
      out.textContent = value.toLocaleString('en-GB');
    }

    function render() {
      const cuttings = Math.floor(Number(cuttingsEl.value));
      if (!Number.isFinite(cuttings) || cuttings <= 0) {
        hint.hidden = false;
        resultEls.forEach((el) => (el.hidden = true));
        return;
      }

      const plan = computeConsumablesPlan(
        cuttings,
        Number(cellCountEl.value),
        isYes(pottingOnEl),
        isYes(domesEl),
        isYes(stakedEl),
        readBuffer(),
      );

      showRow(rowTrays, traysOut, plan.traysNeeded);
      showRow(rowPots, potsOut, plan.potsNeeded);
      showRow(rowLabels, labelsOut, plan.labelsNeeded);
      showRow(rowDomes, domesOut, plan.domesNeeded);
      showRow(rowTies, tiesOut, plan.tiesNeeded);

      quoteLink.href = buildQuotationHref({
        source: 'consumables-planner',
        items: {
          trays: plan.traysNeeded,
          pots: plan.potsNeeded,
          labels: plan.labelsNeeded,
          domes: plan.domesNeeded,
          ties: plan.tiesNeeded,
        },
      });

      hint.hidden = true;
      resultEls.forEach((el) => (el.hidden = false));
    }

    form.addEventListener('input', render);
    form.addEventListener('change', render);

    render();
  }
</script>

<style>
  .tool-page {
    padding: var(--space-6) 0 var(--space-7);
    background: var(--white);
  }

  .tool-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .js-required {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    font-size: 15px;
    line-height: 1.6;
    max-width: 60ch;
  }

  .js-required a {
    color: var(--green);
    font-weight: 600;
  }

  /* Inputs on the left, a live answer panel on the right — the two things a
     calculator is, side by side instead of stacked with a rule between them.
     Below 900px there isn't room for both at once, so it drops to a single
     column in reading order: fill in the form, then see what it worked out.
     `align-items: stretch` (the grid default) plus each panel's own flex
     column and the CTA's `margin-top: auto` is what keeps the results panel
     the same height as the form regardless of how much the results panel
     actually has to show — the taller panel sets the row height, the
     shorter one stretches to match, same technique as the footer's
     newsletter card (DECISIONS.md). */
  .calculator {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .calculator {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
      background: var(--white);
      box-shadow: var(--shadow-soft);
      border-radius: var(--radius-l);
      padding: var(--space-4);
    }

    .form-panel {
      border: none;
      border-radius: 0;
      padding: 0 var(--space-4) 0 0;
      border-right: 1px solid var(--rule);
    }

    .results-panel {
      border: none;
      position: sticky;
      top: calc(var(--space-4) + 68px);
    }
  }

  /* A class that sets `display` unconditionally beats the browser's own
     `[hidden] { display: none }` rule. Every element this page hides via the
     `hidden` property needs its own override. */
  .calculator[hidden] {
    display: none;
  }

  .form-panel,
  .results-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    padding: var(--space-4);
  }

  .form-panel {
    background: var(--white);
  }

  /* The one tinted ground the palette allows — used here, not as decoration,
     to mark this panel as the calculator's answer rather than more input. */
  .results-panel {
    background: var(--mint);
  }

  .panel-label {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 var(--space-3);
  }

  form {
    display: grid;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  /* A small mono uppercase label reads as a spec caption, not a heavy
     sentence-case instruction — the same weight shift the trust panel and
     journey captions already went through this session. */
  label {
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--soft);
  }

  input,
  select {
    width: 100%;
    font-family: var(--f-sans);
    font-size: 16px;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    padding: 11px 12px;
  }

  input:focus-visible,
  select:focus-visible {
    border-color: var(--green);
  }

  /* Three related yes/no facts, grouped as checkboxes rather than three
     separate "No / Yes" dropdowns — the same choice, read at a glance
     instead of opened one at a time. */
  .toggle-group {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-1);
    border-top: 1px solid var(--rule);
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
  }

  .toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--green);
    cursor: pointer;
  }

  .hint {
    color: var(--soft);
    font-size: 14px;
    line-height: 1.55;
  }

  /* Results as a grid of stat tiles instead of a stacked list of
     label/value rows — the same facts read in less vertical space, which is
     most of what keeps this panel from outgrowing the form. An odd row
     count (a toggle turns one item off) just leaves the last tile alone in
     its row rather than stretching to fill it. */
  .stat-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--rule);
    border-radius: var(--radius-s);
    overflow: hidden;
  }

  .stat-grid[hidden] {
    display: none;
  }

  .stat-tile {
    background: var(--white);
    padding: var(--space-2);
  }

  dt {
    font-family: var(--f-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--soft);
  }

  dd {
    margin: 3px 0 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  dd.mono {
    font-family: var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .disclaimer {
    margin: var(--space-2) 0 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--soft);
  }

  .btn-primary {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 22px;
    border-radius: var(--radius-s);
    background: var(--green);
    color: var(--paper);
    border: 1px solid var(--green);
  }

  .btn-primary[hidden] {
    display: none;
  }

  .btn-primary:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn-arrow {
      display: inline-block;
      transition: transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    .btn-primary:hover .btn-arrow {
      transform: translateX(3px);
    }
  }
</style>
