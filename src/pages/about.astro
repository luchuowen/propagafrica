---
// About — blueprint.md Section 12. Full replacement of the pre-restart page: old copy, old
// components (PageHero, NotesBlock, QuotationBlock, RuledRows) and the old farmAerialImg asset
// are dropped entirely, same as the homepage/products/field-notes rebuilds before it. Those
// components are left in place, unreferenced, same as StageNav.astro after Prompt 0.
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustPanel from '../components/TrustPanel.astro';
import FamilyCta from '../components/products/FamilyCta.astro';

const bodyParagraphs = [
  'PropagAfrica Technologies supplies the grafting tubes, clips, nursery consumables, propagation systems, sanitation products and monitoring tools that commercial nurseries, flower farms and fruit and vegetable growers run on, with stock held in Kenya and Ethiopia and technical support from setup through to season one.',
  'We work with commercial flower growers, vegetable and fruit growers, nurseries and propagation labs, agri-businesses and distributors, and research and training institutions — supplying products sourced from established manufacturers, alongside the technical expertise to specify, install and troubleshoot the systems around them.',
  'Our team supports customers on-site, virtually and at the farm, from choosing the right tube and clip for a graft run through to designing and installing a full propagation system and its monitoring.',
];

const photos = [
  {
    src: '/images/about/team-01.jpg',
    alt: 'A PropagAfrica Technologies team member reviewing a grafting batch with a customer at a nursery bench',
  },
  {
    src: '/images/about/team-02.jpg',
    alt: 'A PropagAfrica Technologies technician working with propagation equipment on site',
  },
  {
    src: '/images/about/nairobi-hub.jpg',
    alt: 'The PropagAfrica Technologies stock and dispatch hub in Nairobi, Kenya',
  },
];
---

<BaseLayout
  title="About"
  description="PropagAfrica Technologies supplies propagation inputs and systems for East African horticulture, with stock held in Kenya and Ethiopia and technical support from setup through to season one."
>
  <section class="about-hero">
    <div class="about-hero-inner">
      <p class="eyebrow">About PropagAfrica Technologies</p>
      <h1>Propagation inputs and systems for East African horticulture</h1>
      {bodyParagraphs.map((paragraph) => (
        <p class="body">{paragraph}</p>
      ))}
    </div>
  </section>

  <TrustPanel />

  <section class="about-photos">
    <div class="about-photos-inner">
      <ul class="photo-grid" data-reveal-group>
        {photos.map((photo) => (
          <li data-reveal>
            <img src={photo.src} alt={photo.alt} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="about-contact">
    <div class="about-contact-inner" data-reveal>
      <h2>Contact</h2>
      <address>
        <a href="tel:+254722861682">+254 722 861 682</a>
        <br />
        <a href="mailto:info@propagafrica.com">info@propagafrica.com</a>
        <br />
        Nairobi, Kenya
        <br />
        Stock held in Kenya and Ethiopia
      </address>
      <FamilyCta />
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-6) 0 var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .about-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .about-hero-inner h1 {
    margin-top: var(--space-2);
    max-width: 28ch;
  }

  .about-hero-inner .body {
    margin-top: var(--space-3);
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
  }

  .about-hero-inner .body:first-of-type {
    margin-top: var(--space-4);
  }

  .about-photos {
    padding: var(--space-6) 0;
    background: var(--white);
  }

  .about-photos-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .photo-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .photo-grid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-s);
  }

  .about-contact {
    padding: var(--space-6) 0 var(--space-7);
  }

  .about-contact-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  address {
    font-style: normal;
    margin-top: var(--space-3);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink);
  }

  address a {
    color: var(--green);
  }
</style>
