---
// Field Notes article -- blueprint.md Section 11. Cover image, body copy,
// a closing quotation CTA and 1-2 related links into the other four articles.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ARTICLE_ORDER } from '../../data/field-notes/order';
import { articleJsonLd } from '../../lib/seo';

interface FieldNoteFrontmatter {
  slug: string;
  title: string;
  dek: string;
  cover: string;
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type FieldNoteModule = { frontmatter: FieldNoteFrontmatter; Content: any };

function loadFieldNotes() {
  const modules = import.meta.glob<FieldNoteModule>('../../data/field-notes/*.md', {
    eager: true,
  });
  return new Map(Object.values(modules).map((m) => [m.frontmatter.slug, m]));
}

export async function getStaticPaths() {
  const modules = import.meta.glob<{ frontmatter: { slug: string } }>(
    '../../data/field-notes/*.md',
    { eager: true },
  );
  return Object.values(modules).map((m) => ({ params: { slug: m.frontmatter.slug } }));
}

const bySlug = loadFieldNotes();
const { slug } = Astro.params;
const entry = slug ? bySlug.get(slug) : undefined;

if (!entry) {
  throw new Error(`No field note for slug: ${slug}`);
}

const { frontmatter, Content } = entry;

// Up to two related articles: the next two in ARTICLE_ORDER, wrapping around,
// always drawn from the other four Field Notes -- never the article itself.
const position = ARTICLE_ORDER.indexOf(frontmatter.slug);
const related = [1, 2]
  .map((offset) => ARTICLE_ORDER[(position + offset) % ARTICLE_ORDER.length]!)
  .map((s) => bySlug.get(s)?.frontmatter)
  .filter((f): f is FieldNoteFrontmatter => Boolean(f));

const jsonLd = articleJsonLd({
  site: Astro.site!,
  path: `/field-notes/${frontmatter.slug}`,
  headline: frontmatter.title,
  description: frontmatter.dek,
});
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.dek}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="note">
    <div class="note-inner">
      <header class="note-header">
        <p class="eyebrow">Field Notes</p>
        <h1>{frontmatter.title}</h1>
        <p class="dek">{frontmatter.dek}</p>
      </header>

      <div class="note-media">
        <img src={frontmatter.cover} alt="" loading="lazy" />
      </div>

      <div class="article-body">
        <Content />
      </div>

      <div class="note-cta">
        <a class="btn btn-primary" href="/contact/">
          Request a Quotation
        </a>
      </div>

      {related.length > 0 && (
        <nav class="related" aria-label="Related Field Notes">
          <p class="related-label">Related</p>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/field-notes/${r.slug}`}>{r.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .note {
    padding: var(--space-6) 0 var(--space-7);
  }

  .note-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .note-header {
    max-width: 68ch;
  }

  .note-header .eyebrow {
    margin-bottom: var(--space-2);
  }

  .dek {
    margin-top: var(--space-3);
    font-size: 18px;
    color: var(--soft);
  }

  .note-media {
    margin-top: var(--space-5);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--mint);
    max-width: 68ch;
  }

  .note-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-body {
    max-width: 68ch;
    margin-top: var(--space-6);
    font-size: 17px;
    line-height: 1.8;
  }

  .article-body :global(p) {
    margin-top: var(--space-3);
  }

  .article-body :global(p:first-child) {
    margin-top: 0;
  }

  .note-cta {
    max-width: 68ch;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .btn-primary {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 11px 22px;
    border-radius: var(--radius-s);
    background: var(--green);
    color: var(--paper);
    border: 1px solid var(--green);
  }

  .btn-primary:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
  }

  .related {
    max-width: 68ch;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .related-label {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .related ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .related a {
    font-weight: 600;
    font-size: 15.5px;
    color: var(--green);
    text-decoration: none;
  }

  .related a:hover {
    text-decoration: underline;
  }
</style>
