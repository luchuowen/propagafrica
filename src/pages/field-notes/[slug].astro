---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import Figure from '../../components/Figure.astro';
import { ARTICLE_ORDER } from '../../data/field-notes/order';
import { articleJsonLd } from '../../lib/seo';

import graftUnionStagesSvg from '../../assets/figures/words/graft-union-stages.svg?raw';
import boreFitSvg from '../../assets/figures/words/bore-fit.svg?raw';
// Session 8 integration: the three figures below are drawn by session 3 and
// live in its folder. The parallel-run rule that kept this page out of that
// folder applied only while the sessions ran side by side.
import traceabilityChainSvg from '../../assets/figures/supplies/traceability-chain.svg?raw';
import dilutionSvg from '../../assets/figures/supplies/dilution.svg?raw';
import cellSectionSvg from '../../assets/figures/supplies/cell-section.svg?raw';

interface FieldNoteFrontmatter {
  slug: string;
  title: string;
  standfirst: string;
  category: string;
  readingMinutes: number;
  figure?: string;
}

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type FieldNoteModule = { frontmatter: FieldNoteFrontmatter; Content: any };

function loadFieldNotes() {
  const modules = import.meta.glob<FieldNoteModule>('../../data/field-notes/*.md', {
    eager: true,
  });
  return new Map(Object.values(modules).map((m) => [m.frontmatter.slug, m]));
}

export async function getStaticPaths() {
  const modules = import.meta.glob<{ frontmatter: { slug: string } }>(
    '../../data/field-notes/*.md',
    { eager: true },
  );
  return Object.values(modules).map((m) => ({ params: { slug: m.frontmatter.slug } }));
}

const bySlug = loadFieldNotes();
const { slug } = Astro.params;
const entry = slug ? bySlug.get(slug) : undefined;

if (!entry) {
  throw new Error(`No field note for slug: ${slug}`);
}

const { frontmatter, Content } = entry;

const FIGURES: Record<string, string> = {
  'graft-union-stages': graftUnionStagesSvg,
  'bore-fit': boreFitSvg,
  'traceability-chain': traceabilityChainSvg,
  dilution: dilutionSvg,
  'cell-section': cellSectionSvg,
};

const FIGURE_CAPTIONS: Record<string, string> = {
  'graft-union-stages':
    'The union forms in three stages: the cut faces are pressed together at day 0, a callus bridges the gap across days 2 to 7, and a vascular connection is established across days 7 to 14.',
  'bore-fit':
    'Three sleeves in section over the same measured stem: one size over leaves a persistent gap, the correct size seats snugly to tolerance, and one size under compresses the cambium.',
  'traceability-chain':
    'The record chain from supplier batch code through to the plant that leaves the house. If the supplier\u2019s batch code is missing, the chain breaks at the first link \u2014 and the finding lands on the grower, not on the supplier.',
  dilution:
    'Concentrate to working strength, drawn out. The arithmetic is printed because the failure mode is a supervisor guessing a capful: a dip made at a tenth of the intended strength is not biosecurity, it is the appearance of it.',
  'cell-section':
    'A tray cell in section. Under-filling costs root volume; over-filling closes the drainage path and waterlogs the base of the cell. Six millimetres of headspace is the working target.',
};

const FIGURE_NUMBERS: Record<string, number> = {
  'graft-union-stages': 1,
  'bore-fit': 2,
  'traceability-chain': 3,
  dilution: 4,
  'cell-section': 5,
};

const position = ARTICLE_ORDER.indexOf(frontmatter.slug);
const prevSlug = position > 0 ? ARTICLE_ORDER[position - 1] : undefined;
const nextSlug =
  position >= 0 && position < ARTICLE_ORDER.length - 1 ? ARTICLE_ORDER[position + 1] : undefined;
const prev = prevSlug ? bySlug.get(prevSlug)?.frontmatter : undefined;
const next = nextSlug ? bySlug.get(nextSlug)?.frontmatter : undefined;

const drawingNo = `FN-${String(position + 1).padStart(2, '0')}`;

const jsonLd = articleJsonLd({
  site: Astro.site!,
  path: `/field-notes/${frontmatter.slug}`,
  headline: frontmatter.title,
  description: frontmatter.standfirst,
});

const figureKey = frontmatter.figure;
const figureSvg = figureKey ? FIGURES[figureKey] : undefined;
const figureCaption = figureKey ? FIGURE_CAPTIONS[figureKey] : undefined;
const figureNumber = figureKey ? FIGURE_NUMBERS[figureKey] : undefined;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.standfirst}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="note">
    <div class="note-inner">
      <header class="note-header">
        <p class="eyebrow">{frontmatter.category.toUpperCase()}</p>
        <h1>{frontmatter.title}</h1>
        <p class="standfirst">{frontmatter.standfirst}</p>
        <TitleBlock
          drawingNo={drawingNo}
          subject={frontmatter.category.toUpperCase()}
          dimension={`${frontmatter.readingMinutes} MIN READ`}
        />
      </header>

      {figureSvg && figureCaption && figureNumber !== undefined ? (
        <Figure
          number={figureNumber}
          subject={frontmatter.title}
          caption={figureCaption}
          sheet={12}
          sheetsTotal={14}
        >
          <Fragment set:html={figureSvg} />
        </Figure>
      ) : null}

      <div class="article-body">
        <Content />
      </div>

      <nav class="prev-next" aria-label="Field Notes navigation">
        <a class="prev" href={prev ? `/field-notes/${prev.slug}` : '/field-notes'}>
          <span class="direction">← Previous</span>
          <span class="link-title">{prev ? prev.title : 'Field Notes'}</span>
        </a>
        <a class="next" href={next ? `/field-notes/${next.slug}` : '/field-notes'}>
          <span class="direction">Next →</span>
          <span class="link-title">{next ? next.title : 'Field Notes'}</span>
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .note {
    padding: var(--space-6) 0 var(--space-7);
  }

  .note-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .note-header {
    max-width: 68ch;
  }

  .note-header .eyebrow {
    margin-bottom: var(--space-2);
  }

  .standfirst {
    margin-top: var(--space-3);
    font-size: 18px;
    color: var(--ink-soft);
  }

  .note-header :global(.title-block) {
    margin-top: var(--space-4);
  }

  .note-inner :global(figure) {
    margin-top: var(--space-6);
  }

  .article-body {
    max-width: 68ch;
    margin-top: var(--space-6);
    font-size: 17px;
    line-height: 1.8;
  }

  .article-body :global(p) {
    margin-top: var(--space-3);
  }

  .article-body :global(p:first-child) {
    margin-top: 0;
  }

  .article-body :global(h2) {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .article-body :global(h2 + p) {
    margin-top: var(--space-3);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: var(--space-3);
    padding-left: 1.3em;
  }

  .article-body :global(li + li) {
    margin-top: 6px;
  }

  .article-body :global(table) {
    display: block;
    overflow-x: auto;
    margin-top: var(--space-4);
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-mono);
    font-size: 12px;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--rule);
    padding: 6px 12px;
    text-align: left;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .article-body :global(th) {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .prev-next {
    max-width: 68ch;
    margin-top: var(--space-7);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .prev-next a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: var(--ink);
    max-width: 48%;
  }

  .prev-next .next {
    text-align: right;
    align-items: flex-end;
  }

  .prev-next a:hover .link-title {
    color: var(--green);
  }

  .direction {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .link-title {
    font-weight: 700;
  }
</style>
