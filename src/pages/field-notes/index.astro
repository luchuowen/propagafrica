---
// Field Notes hub -- blueprint.md Section 11. Five article cards, in the
// order order.ts fixes.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FIELD_NOTES } from '../../data/field-notes/articles';
---

<BaseLayout
  title="Field Notes"
  description="Short, practical articles on grafting, propagation environment and nursery operations, written for growers across Africa."
>
  <section class="hub">
    <div class="hub-inner">
      <p class="eyebrow">Field Notes</p>
      <h1>Practical guidance for propagation nurseries</h1>
      <p class="hub-sub">
        Short, practical articles on grafting, propagation environment and nursery operations,
        written for growers across Africa.
      </p>

      <ul class="note-grid">
        {FIELD_NOTES.map((note) => (
          <li class="note-card">
            <div class="note-media">
              <img src={note.cover} alt="" loading="lazy" />
            </div>
            <div class="note-body">
              <h2>
                <a href={`/field-notes/${note.slug}`}>{note.title}</a>
              </h2>
              <p class="dek">{note.dek}</p>
              <a class="link-arrow" href={`/field-notes/${note.slug}`}>
                Read &rarr;
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hub {
    padding: var(--space-6) 0 var(--space-7);
    background: var(--white);
  }

  .hub-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  h1 {
    margin-top: var(--space-2);
    max-width: 26ch;
  }

  .hub-sub {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--soft);
    max-width: 60ch;
  }

  .note-grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .note-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .note-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .note-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .note-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--mint);
  }

  .note-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .note-body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .note-body h2 {
    font-size: 18px;
  }

  .note-body h2 a {
    text-decoration: none;
  }

  .note-body h2 a:hover {
    text-decoration: underline;
  }

  .dek {
    margin-top: var(--space-2);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--soft);
    flex: 1;
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }
</style>
