---
// Products hub — blueprint.md Section 2. Seven family cards in flyer order,
// each linking to its own built page via families.ts's href.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_FAMILIES, CROP_ALL, CROP_TAGS } from '../../data/products/families';
---

<BaseLayout
  title="Products"
  description="Seven product families, sourced and stocked for commercial growers in Kenya and Ethiopia. Filter by what you grow, or browse the full range below."
  image="/images/og/og-products.jpg"
>
  <section class="hub">
    <div class="hub-inner">
      <p class="eyebrow">Full range</p>
      <h1>Everything a propagation nursery runs on</h1>
      <p class="hub-sub">
        Seven product families, sourced and stocked for commercial growers in Kenya and Ethiopia.
        Filter by what you grow, or browse the full range below.
      </p>

      <div class="filter-pills" role="group" aria-label="Filter products by what you grow">
        <button type="button" class="pill is-active" data-tag={CROP_ALL}>
          All
        </button>
        {CROP_TAGS.map((tag) => (
          <button type="button" class="pill" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <ul class="product-grid" data-product-grid>
        {PRODUCT_FAMILIES.map((f) => (
          <li class="product-card" data-product-card data-tags={f.tags.join('|')}>
            <div class="product-media">
              <img src={f.img} alt={f.imgAlt} loading="lazy" />
            </div>
            <div class="product-body">
              <h2>
                <a href={f.href}>{f.name}</a>
              </h2>
              <p class="tagline">{f.tagline}</p>
              <p class="descriptor">{f.descriptor}</p>
              <ul class="key-bullets">
                {f.keyBullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="link-arrow" href={f.href}>
                View range &rarr;
              </a>
            </div>
          </li>
        ))}
      </ul>
      <p class="filter-empty" data-filter-empty hidden>
        No product families match that filter.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initProductFilter } from '../../lib/product-filter';
  initProductFilter();
</script>

<style>
  .hub {
    padding: var(--space-6) 0 var(--space-7);
  }

  .hub-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  h1 {
    margin-top: var(--space-2);
    max-width: 26ch;
  }

  .hub-sub {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--soft);
    max-width: 60ch;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .pill {
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .pill:hover {
    border-color: var(--green);
  }

  .pill.is-active {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
  }

  .product-grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .product-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mint);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-body h2 {
    font-size: 18px;
  }

  .product-body h2 a {
    text-decoration: none;
  }

  .product-body h2 a:hover {
    text-decoration: underline;
  }

  .tagline {
    margin-top: 4px;
    font-weight: 600;
    font-size: 13.5px;
    color: var(--green);
  }

  .descriptor {
    margin-top: var(--space-2);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--soft);
  }

  .key-bullets {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .key-bullets li {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink);
    padding-left: 14px;
    position: relative;
  }

  .key-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    background: var(--terra);
    border-radius: 50%;
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }

  .filter-empty {
    margin-top: var(--space-4);
    color: var(--soft);
    font-size: 15px;
  }
</style>
