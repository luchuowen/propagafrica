---
// Products hub — blueprint.md Section 2. Seven family cards in flyer order,
// each linking to its own built page via families.ts's href.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_FAMILIES, CROP_ALL, CROP_TAGS } from '../../data/products/families';
---

<BaseLayout
  title="Products"
  description="Seven product families for commercial growers across Africa, sourced and stocked from regional hubs in Kenya and Ethiopia. Filter by what you grow, or browse the full range below."
>
  <section class="hub">
    <div class="hub-inner">
      <p class="eyebrow">Full range</p>
      <h1>Everything a propagation nursery runs on</h1>
      <p class="hub-sub">
        Seven product families for commercial growers across Africa, sourced and stocked from
        regional hubs in Kenya and Ethiopia. Filter by what you grow, or browse the full range
        below.
      </p>

      <div class="filter-pills" role="group" aria-label="Filter products by what you grow">
        <button type="button" class="pill is-active" data-tag={CROP_ALL}>
          All
        </button>
        {CROP_TAGS.map((tag) => (
          <button type="button" class="pill" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <ul class="product-grid" data-product-grid data-reveal-group>
        {PRODUCT_FAMILIES.map((f) => (
          <li class="product-card" data-product-card data-tags={f.tags.join('|')} data-reveal>
            <div class="product-media">
              <img src={f.img} alt="" loading="lazy" />
            </div>
            <div class="product-body">
              <h2>
                <a href={f.href}>{f.name}</a>
              </h2>
              <p class="descriptor">{f.descriptor}</p>
              <p class="key-bullets">{f.keyBullets.join(' · ')}</p>
              <span class="product-foot">
                <span>View range</span>
                <span class="product-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </span>
            </div>
          </li>
        ))}
      </ul>
      <p class="filter-empty" data-filter-empty hidden>
        No product families match that filter.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initProductFilter } from '../../lib/product-filter';
  initProductFilter();
</script>

<style>
  .hub {
    padding: var(--space-6) 0 var(--space-7);
    background: var(--white);
  }

  .hub-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  h1 {
    margin-top: var(--space-2);
    max-width: 26ch;
  }

  .hub-sub {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--soft);
    max-width: 60ch;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  /* The crop filter only ever narrows this page's own 7-card grid — on a
     phone it's a row of chips that cost more vertical space than the
     filtering saves. Desktop is unchanged. */
  @media (max-width: 640px) {
    .filter-pills {
      display: none;
    }
  }

  .pill {
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }

  .pill:hover {
    border-color: var(--green);
  }

  .pill.is-active {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
  }

  .product-grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* A white mount with the photograph inset on it — the same card as the
     homepage teaser, with this page's key-products list added. */
  .product-card {
    position: relative;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    padding: 10px;
    background: var(--white);
    display: flex;
    flex-direction: column;
  }

  .product-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--mint);
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-card {
      transition:
        transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1),
        box-shadow 300ms ease;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-soft);
    }

    .product-media img {
      transition: transform 600ms ease;
    }

    .product-card:hover .product-media img {
      transform: scale(1.04);
    }

    .product-arrow {
      transition:
        background-color 300ms ease,
        border-color 300ms ease,
        color 300ms ease,
        transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    .product-card:hover .product-arrow {
      transform: translateX(3px);
    }
  }

  .product-body {
    padding: var(--space-2) 14px 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-align: center;
  }

  .product-body h2 {
    font-size: 21px;
    letter-spacing: -0.022em;
    line-height: 1.2;
  }

  .product-body h2 a {
    text-decoration: none;
  }

  /* The whole card is the target; the heading link carries the accessible
     name and the focus ring. */
  .product-body h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }

  .descriptor {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--soft);
  }

  /* A single wrapped spec line rather than one bullet per row — the same
     four facts, at roughly a third of the vertical space. Reads as a
     catalogue spec (mono, like a SKU) rather than a feature list, which
     suits facts this short anyway. */
  .key-bullets {
    margin: var(--space-2) 0 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  /* Pinned to the bottom of the card so every "View range" in the row lines
     up, whatever that family's bullet count and descriptor do. */
  .product-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 600;
    font-size: 14px;
    color: var(--green);
  }

  .product-arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--green);
  }

  .product-card:hover .product-arrow {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }

  .filter-empty {
    margin-top: var(--space-4);
    color: var(--soft);
    font-size: 15px;
  }
</style>
