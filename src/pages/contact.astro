---
// Contact — blueprint.md Section 13. Full replacement of the pre-restart page's copy and
// layout; the working submitQuotation Cloud Function, Firestore write, rate limiting and email
// alert (functions/**) are kept — only QuoteForm's fields, labels and copy changed to match the
// new Enquiring-about field set (see src/lib/quotation/schema.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/quote/QuoteForm.astro';
---

<BaseLayout
  title="Contact — request a quotation"
  description="Tell PropagAfrica Technologies what you're growing, roughly how much, and where you're based — we'll come back with the right products, systems or services for your order."
  image="/images/og/og-contact.jpg"
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Get in touch</p>
      <h1>Request a Quotation</h1>
      <p class="hero-sub">
        Tell us what you&rsquo;re growing, roughly how much, and where you&rsquo;re based —
        we&rsquo;ll come back with the right products, systems or services and packaging for your
        order.
      </p>
    </div>
  </section>

  <section class="contact">
    <div class="contact-inner">
      <div class="contact-form-col">
        <QuoteForm />
      </div>
      <aside class="contact-panel">
        <div class="panel-media">
          <img
            src="/images/about/nairobi-hub.jpg"
            alt="The PropagAfrica Technologies stock and dispatch hub in Nairobi, Kenya"
            loading="lazy"
          />
        </div>
        <h2>Talk to us directly</h2>
        <address>
          <a href="tel:+254722861682">+254 722 861 682</a> (Emily)
          <br />
          <a href="mailto:info@propagafrica.com">info@propagafrica.com</a>
          <br />
          Nairobi, Kenya — East Africa Hub
          <br />
          Stock held in Kenya and Ethiopia
        </address>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding: var(--space-6) 0 var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .contact-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .contact-hero-inner h1 {
    margin-top: var(--space-2);
    max-width: 22ch;
  }

  .hero-sub {
    margin-top: var(--space-3);
    font-size: 18px;
    line-height: 1.7;
    color: var(--soft);
    max-width: 56ch;
  }

  .contact {
    padding: var(--space-6) 0 var(--space-7);
  }

  .contact-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .contact-inner {
      grid-template-columns: 1fr 320px;
      align-items: start;
    }
  }

  .contact-panel {
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    overflow: hidden;
  }

  .panel-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .contact-panel h2 {
    margin: var(--space-3) var(--space-3) 0;
    font-size: 1.05rem;
  }

  .contact-panel address {
    font-style: normal;
    margin: var(--space-2) var(--space-3) var(--space-3);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink);
  }

  .contact-panel address a {
    color: var(--green);
  }
</style>
