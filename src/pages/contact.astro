---
// Contact — blueprint.md Section 13. Full replacement of the pre-restart page's copy and
// layout; the working submitQuotation Cloud Function, Firestore write, rate limiting and email
// alert (functions/**) are kept — only QuoteForm's fields, labels and copy changed to match the
// new Enquiring-about field set (see src/lib/quotation/schema.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/quote/QuoteForm.astro';
---

<BaseLayout
  title="Contact — request a quotation"
  description="Tell PropagAfrica Technologies what you're growing, roughly how much, and where you're based — we'll come back with the right products, systems or services for your order."
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Get in touch</p>
      <h1>Request a Quotation</h1>
      <p class="hero-sub">
        Tell us what you&rsquo;re growing, roughly how much, and where you&rsquo;re based —
        we&rsquo;ll come back with the right products, systems or services and packaging for your
        order.
      </p>
    </div>
  </section>

  <section class="contact">
    <div class="contact-inner">
      <div class="contact-form-col" data-reveal>
        <div class="contact-form-card">
          <QuoteForm />
        </div>
      </div>
      <aside class="contact-panel" data-reveal>
        <div class="panel-media">
          <img
            src="/images/about/nairobi-hub.jpg"
            alt="The PropagAfrica Technologies stock and dispatch hub in Nairobi, Kenya"
            loading="lazy"
          />
        </div>
        <h2>Talk to us directly</h2>
        <div class="contact-methods">
          <a class="method-card" href="tel:+254722861682">
            <span class="method-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                <path
                  d="M4.5 3h2.7l1 3.4-1.7 1.4a10.5 10.5 0 0 0 4.7 4.7l1.4-1.7 3.4 1v2.7c0 .8-.7 1.4-1.5 1.3-3-.4-5.8-1.8-8-4-2.2-2.2-3.6-5-4-8C3.1 3.7 3.7 3 4.5 3Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="method-text">
              <span class="method-label">Call us</span>
              <span class="method-value">+254 722 861 682 <span class="method-note">(Emily)</span></span>
            </span>
          </a>
          <a class="method-card" href="mailto:info@propagafrica.com">
            <span class="method-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                <rect x="3" y="4.5" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                <path
                  d="m3.5 5.5 6 5 6-5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="method-text">
              <span class="method-label">Email us</span>
              <span class="method-value">info@propagafrica.com</span>
            </span>
          </a>
        </div>
        <p class="location-line">
          Nairobi, Kenya — East Africa Hub
          <br />
          Regional stock hubs in Kenya and Ethiopia
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding: var(--space-6) 0 var(--space-5);
    border-bottom: 1px solid var(--rule);
    background: var(--white);
  }

  .contact-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .contact-hero-inner h1 {
    margin-top: var(--space-2);
    max-width: 22ch;
  }

  .hero-sub {
    margin-top: var(--space-3);
    font-size: 18px;
    line-height: 1.7;
    color: var(--soft);
    max-width: 56ch;
  }

  .contact {
    padding: var(--space-6) 0 var(--space-7);
    background: var(--white);
  }

  .contact-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .contact-inner {
      grid-template-columns: 1fr 320px;
      align-items: start;
    }
  }

  /* Both the form and the direct-contact panel are white cards sitting on
     the section's white ground, distinguished by border + shadow only —
     the same "card vs. section" contrast used for the product/tools/
     field-notes cards elsewhere, none of which use --paper as a card fill. */
  .contact-form-card {
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
  }

  .contact-panel {
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    background: var(--white);
  }

  .panel-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .contact-panel h2 {
    margin: var(--space-3) var(--space-3) 0;
    font-size: 1.05rem;
  }

  .contact-methods {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) var(--space-3) 0;
  }

  .method-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    text-decoration: none;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .method-card {
      transition:
        border-color 200ms ease,
        background-color 200ms ease;
    }
  }

  .method-card:hover {
    border-color: var(--green);
    background: var(--mint);
  }

  .method-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--green);
  }

  .method-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .method-label {
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft);
  }

  .method-value {
    font-size: 14.5px;
    font-weight: 600;
    overflow-wrap: break-word;
  }

  .method-note {
    font-weight: 400;
    color: var(--soft);
  }

  .location-line {
    margin: var(--space-3) var(--space-3) var(--space-3);
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--soft);
  }
</style>
