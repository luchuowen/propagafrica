---
interface FactRow {
  label: string;
  value: string;
}

const facts: FactRow[] = [
  { label: 'PUBLISHED', value: 'Bore, wall, grade, pH, conductivity, available chlorine' },
  {
    label: 'WITH CONSIGNMENT',
    value: 'Safety data sheet · certificate of analysis · batch record',
  },
  { label: 'ON EVERY BATCH', value: 'A lot code that reconciles with your nursery records' },
];
---

<section class="spec-promise">
  <div class="wrap">
    <p class="eyebrow">SPECIFICATIONS</p>
    <h2>Every item has a specification, and we publish it.</h2>
    <p>
      Bore and wall thickness for every sleeve. Particle size, bulk density and pH for every grade
      of vermiculite. Formulation, pH and conductivity for every peat. Available chlorine, pack size
      and shelf life for every drum of hypochlorite. Dimensions, material and pack quantity for
      trays, labels and record books.
    </p>
    <p>
      You can read all of it before you speak to anyone. Safety data sheets and certificates of
      analysis are issued with the consignment, and every batch carries a lot code that matches the
      one on your own records.
    </p>
    <dl class="fact-rows">
      {facts.map((fact) => (
        <div class="fact-row">
          <dt class="mono">{fact.label}</dt>
          <dd class="mono">{fact.value}</dd>
        </div>
      ))}
    </dl>
    <a class="link" href="/specifications">
      See the specifications →
    </a>
  </div>
</section>

<style>
  .spec-promise {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
  }

  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .spec-promise p {
    margin-top: var(--space-3);
    max-width: 52em;
  }

  .fact-rows {
    margin: var(--space-5) 0 0;
  }

  .fact-row {
    display: grid;
    grid-template-columns: 13em 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
  }

  .fact-row:first-child {
    border-top: none;
  }

  @media (max-width: 560px) {
    .fact-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .fact-row dt,
  .fact-row dd {
    margin: 0;
    font-size: 11px;
  }

  .fact-row dt {
    color: var(--ink-soft);
  }

  .fact-row dd {
    color: var(--ink);
  }

  .link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 600;
    text-decoration: none;
    color: var(--green);
  }
</style>
