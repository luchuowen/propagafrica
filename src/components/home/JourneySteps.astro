---
// The propagation journey: six numbered steps on one line, looping continuously
// from 01 to 06 and round again. It was a three-at-a-time carousel, then a
// static grid; the loop keeps the whole sequence in one reading order while the
// section edges fade the cards out rather than cutting them off. A second,
// inert copy of the six steps follows the first so the track can translate
// exactly half its width and start over with no visible seam.
interface Step {
  src: string;
  alt: string;
  step: string;
  caption: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;

// Seconds for one pass through the six steps. At the card widths below this is
// roughly 30px a second — slow enough to read a caption as it goes past.
const LOOP_SECONDS = 48;

// Same responsive sources as Carousel.astro: every process photo ships at
// 1200x900 per docs/image-manifest.md, and scripts/generate-image-variants.mjs
// (astro:build:done hook) writes a WebP copy plus a 640w WebP and same-format
// fallback next to it in dist/.
const NATIVE_WIDTH = 1200;
const NATIVE_HEIGHT = 900;
const SIZES = '(min-width: 1540px) 230px, (min-width: 1270px) 15vw, 190px';

function assetVariants(src: string) {
  const match = src.match(/\.(jpe?g|png)$/i);
  const ext = match ? match[0] : '.jpg';
  const base = src.slice(0, -ext.length);
  return {
    webp: `${base}.webp`,
    webpSmall: `${base}-640.webp`,
    fallbackSmall: `${base}-640${ext}`,
  };
}

// The clones carry the same image URLs, so they come straight off the cache and
// never pop in mid-loop.
const cycle = [
  ...steps.map((step) => ({ step, clone: false })),
  ...steps.map((step) => ({ step, clone: true })),
];
---

<!-- Focusable because the row scrolls: with motion it is a tab stop that pauses
the loop, and with reduced motion it is the only way to scroll the row by
keyboard (axe: scrollable-region-focusable). -->
<div
  class="journey-marquee"
  role="group"
  aria-label="The propagation journey, six steps"
  tabindex="0"
>
  <ol class="journey-steps" style={`--loop-duration: ${LOOP_SECONDS}s`}>
    {cycle.map(({ step, clone }) => {
      const { webp, webpSmall, fallbackSmall } = assetVariants(step.src);
      return (
        <li class="step" data-clone={clone ? '' : null} aria-hidden={clone ? 'true' : null}>
          <div class="shot">
            <picture>
              <source
                type="image/webp"
                srcset={`${webpSmall} 640w, ${webp} ${NATIVE_WIDTH}w`}
                sizes={SIZES}
              />
              <img
                src={step.src}
                srcset={`${fallbackSmall} 640w, ${step.src} ${NATIVE_WIDTH}w`}
                sizes={SIZES}
                width={NATIVE_WIDTH}
                height={NATIVE_HEIGHT}
                alt={clone ? '' : step.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <p class="marker">
            <span class="num">{step.step.padStart(2, '0')}</span>
          </p>
          <p class="caption">{step.caption}</p>
        </li>
      );
    })}
  </ol>
</div>

<style>
  /* The viewport runs the full width of the section. The mask is an alpha ramp,
     not paint: it dissolves a card as it reaches either edge instead of
     chopping it off at the overflow boundary. Vertical padding keeps the card
     shadows clear of the clip. */
  .journey-marquee:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  .journey-marquee {
    --fade: clamp(var(--space-3), 8vw, var(--space-8));

    overflow: hidden;
    padding: var(--space-1) 0 var(--space-2);
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      black var(--fade),
      black calc(100% - var(--fade)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      black var(--fade),
      black calc(100% - var(--fade)),
      transparent 100%
    );
  }

  /* width: max-content keeps the track its true length, and the trailing
     margin on every step — rather than a gap — makes the two halves exactly
     equal, which is what lets translateX(-50%) loop seamlessly. */
  .journey-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
  }

  .step {
    flex: 0 0 auto;
    width: clamp(190px, 15vw, 230px);
    margin-right: var(--space-2);
    display: flex;
    flex-direction: column;
  }

  .shot {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    background: var(--green-dark);
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    margin: var(--space-2) 0 0;
  }

  /* The connector runs from the centre of one marker to the centre of the next,
     through the gutter and never across a photograph. The percentage resolves
     against the card width, so 50% + the margin lands on the next marker. */
  .marker::after {
    content: '';
    position: absolute;
    left: 50%;
    right: calc((50% + var(--space-2)) * -1);
    top: 50%;
    height: 1px;
    background: color-mix(in srgb, var(--green) 22%, transparent);
  }

  /* Nothing follows the last card, whether that is a clone or — with the clones
     hidden below — step 06. */
  .step:last-child .marker::after {
    display: none;
  }

  .num {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--green);
  }

  .caption {
    margin: var(--space-2) 0 0;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .journey-steps {
      animation: journey-loop var(--loop-duration) linear infinite;
    }

    /* Pointing at the row or tabbing into it stops the loop, so a caption can
       be read at rest. */
    .journey-marquee:hover .journey-steps,
    .journey-marquee:focus-within .journey-steps {
      animation-play-state: paused;
    }

    .shot img {
      transition: transform 600ms ease;
    }

    .step:hover .shot img {
      transform: scale(1.045);
    }

    @keyframes journey-loop {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }
  }

  /* No motion: the duplicate half comes out and the six steps become a plain
     swipeable row. */
  @media (prefers-reduced-motion: reduce) {
    .journey-marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .step {
      scroll-snap-align: center;
    }

    .step[data-clone] {
      display: none;
    }
  }
</style>
