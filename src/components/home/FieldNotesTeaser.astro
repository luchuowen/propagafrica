---
import { Image } from 'astro:assets';
import { firstFieldNotes } from '../../data/field-notes/articles';

import inspectionImg from '../../assets/images/inspection.jpg';
import houseImg from '../../assets/images/house-wide.jpg';
import storeImg from '../../assets/images/store.jpg';

// The three most recent articles. Field Notes carry no publication date, so
// the order fixed in src/data/field-notes/order.ts — which follows
// docs/content/field-notes.md — is the only ordering signal the deck gives.
const notes = firstFieldNotes(3);
const covers = [inspectionImg, houseImg, storeImg];
const coverAlts = [
  'A propagation manager inspecting a grafted rose cutting through a hand lens',
  'A worker tending trays of young rose cuttings along a misted greenhouse bench',
  'A farm store room stacked with peat bales, trays and drums of sanitiser',
];
---

<section class="notes">
  <div class="notes-inner">
    <div class="notes-head">
      <p class="eyebrow-warm">Field Notes</p>
      <h2>Written for the person who has to make it work on a Monday.</h2>
    </div>

    <ul class="grid">
      {notes.map((note, i) => (
        <li class="note">
          <a href={`/field-notes/${note.slug}`}>
            <span class="note-media">
              <Image
                src={covers[i]!}
                alt={coverAlts[i]!}
                widths={[400, 700]}
                sizes="(min-width: 900px) 32vw, 100vw"
                loading="lazy"
              />
            </span>
            <span class="note-cat">{note.category}</span>
            <span class="note-title">{note.title}</span>
            <span class="note-stand">{note.standfirst}</span>
            <span class="note-time">{note.readingMinutes} min read</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="link-arrow" href="/field-notes">
      All Field Notes &rarr;
    </a>
  </div>
</section>

<style>
  .notes {
    background: var(--green-pale);
    padding: var(--space-7) 0;
  }

  .notes-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .notes-head {
    max-width: 46ch;
  }

  .eyebrow-warm {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-ink);
    margin-bottom: var(--space-2);
  }

  .grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .note a {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .note-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--rule);
  }

  .note-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .note-cat {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .note-title {
    display: block;
    margin-top: 6px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .note a:hover .note-title {
    text-decoration: underline;
  }

  .note-stand {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .note-time {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .link-arrow {
    display: inline-block;
    margin-top: var(--space-5);
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }
</style>
