---
import { Image } from 'astro:assets';
import { firstFieldNotes } from '../../data/field-notes/articles';

import inspectionImg from '../../assets/images/inspection.jpg';
import houseImg from '../../assets/images/house-wide.jpg';
import storeImg from '../../assets/images/store.jpg';

// The three most recent articles. Field Notes carry no publication date, so
// the order fixed in src/data/field-notes/order.ts — which follows
// docs/content/field-notes.md — is the only ordering signal the deck gives.
const notes = firstFieldNotes(3);
const covers = [inspectionImg, houseImg, storeImg];
const coverAlts = [
  'A propagation manager inspecting a grafted rose cutting through a hand lens',
  'A worker tending trays of young rose cuttings along a misted greenhouse bench',
  'A farm store room stacked with peat bales, trays and drums of sanitiser',
];
---

<section class="notes">
  <div class="notes-inner">
    <div class="notes-head">
      <h2>Field Notes</h2>
      <p>Written for the person who has to make it work on a Monday.</p>
      <a class="link-arrow" href="/field-notes">
        All Field Notes &rarr;
      </a>
    </div>

    <ul class="rows">
      {notes.map((note, i) => (
        <li class="note">
          <a href={`/field-notes/${note.slug}`}>
            <span class="note-media">
              <Image
                src={covers[i]!}
                alt={coverAlts[i]!}
                widths={[220, 400]}
                sizes="(min-width: 760px) 150px, 30vw"
                loading="lazy"
              />
            </span>
            <span class="note-body">
              <span class="note-title">{note.title}</span>
              <span class="note-stand">{note.standfirst}</span>
            </span>
            <span class="note-meta">
              <span class="note-cat">{note.category}</span>
              <span class="note-time">{note.readingMinutes} min</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .notes {
    background: var(--green-pale);
    padding: var(--space-6) 0;
  }

  .notes-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .notes-head {
    display: grid;
    gap: var(--space-2) var(--space-5);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }

  @media (min-width: 820px) {
    .notes-head {
      grid-template-columns: minmax(0, 20ch) minmax(0, 1fr) minmax(0, auto);
    }
  }

  .notes-head p {
    font-size: 15px;
    color: var(--ink-soft);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note a {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 760px) {
    .note a {
      grid-template-columns: 150px minmax(0, 1fr) 9rem;
      gap: var(--space-4);
    }
  }

  .note-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--rule);
  }

  .note-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .note-meta {
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .note-title {
    display: block;
    font-family: var(--f-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
  }

  .note a:hover .note-title {
    text-decoration: underline;
  }

  .note-stand {
    display: block;
    margin-top: 4px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .link-arrow {
    display: inline-block;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
  }

  .link-arrow:hover {
    text-decoration: underline;
  }
</style>
