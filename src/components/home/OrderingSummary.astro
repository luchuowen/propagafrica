---
interface Row {
  label: string;
  value: string;
}

const rows: Row[] = [
  {
    label: 'FRAMEWORK AGREEMENT',
    value: 'Specification, indicative annual volume and terms, agreed once',
  },
  {
    label: 'MONTHLY CALL-OFFS',
    value: 'You release quantities as your grafting schedule requires',
  },
  {
    label: 'BUFFER STOCK',
    value: 'Held against agreed volume, so an upstream delay is our problem',
  },
  {
    label: 'QUARTERLY REVIEW',
    value: 'Usage, stock-outs, performance, and cost per surviving plant',
  },
];
---

<section class="ordering-summary">
  <div class="wrap">
    <p class="eyebrow">ORDERING</p>
    <h2>We quote against your programme, not against a price list.</h2>
    <p>
      There are no prices on this site, and that is deliberate. What an item costs you depends on
      annual volume, pack size, the specification you need, where it is delivered and how much
      notice you can give. Tell us the programme and you get a figure that holds.
    </p>
    <dl class="rows">
      {rows.map((row) => (
        <div class="row">
          <dt class="mono">{row.label}</dt>
          <dd class="mono">{row.value}</dd>
        </div>
      ))}
    </dl>
    <a class="link" href="/ordering">
      How ordering works →
    </a>
  </div>
</section>

<style>
  .ordering-summary {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
  }

  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .ordering-summary p {
    margin-top: var(--space-3);
    max-width: 50em;
  }

  .rows {
    margin: var(--space-5) 0 0;
  }

  .row {
    display: grid;
    grid-template-columns: 14em 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
  }

  .row:first-child {
    border-top: none;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .row dt,
  .row dd {
    margin: 0;
    font-size: 11px;
  }

  .row dt {
    color: var(--ink-soft);
  }

  .row dd {
    color: var(--ink);
  }

  .link {
    display: inline-block;
    margin-top: var(--space-4);
    font-weight: 600;
    text-decoration: none;
    color: var(--green);
  }
</style>
