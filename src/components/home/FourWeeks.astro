---
import Figure from '../Figure.astro';
import GraftJoin from '../../assets/figures/home/GraftJoin.astro';
---

<section class="four-weeks">
  <div class="wrap">
    <p class="eyebrow">THE FIRST FOUR WEEKS</p>
    <h2>Grafting joins the top of one plant to the roots of another.</h2>
    <p>
      For about four weeks that join has to be held still, kept damp and kept clean while it knits
      together and puts out roots. Most of the plants a nursery loses are lost in that window, and
      the loss is invisible until the count at the end of it.
    </p>
    <p>
      Every item we sell does one job in those four weeks. That is why the catalogue is arranged the
      way the work is, and why the sleeve you order is chosen against a measured stem rather than a
      product name.
    </p>
    <p class="mono callout">SIZE IT AGAINST A MEASURED STEM, NOT AGAINST A NAME</p>
    <a class="link" href="/how-grafting-works">
      How grafting works →
    </a>
  </div>
  <div class="wrap figure-wrap">
    <Figure
      number={1}
      subject="The graft join, held in a PRO-ROSE 45 sleeve"
      caption="The graft join, held in a PRO-ROSE 45 sleeve."
      sheet={1}
    >
      <GraftJoin />
    </Figure>
  </div>
</section>

<style>
  .four-weeks {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--rule);
  }

  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .four-weeks .wrap > p {
    margin-top: var(--space-3);
    max-width: 46em;
  }

  .four-weeks h2 {
    margin-top: var(--space-2);
    max-width: 30em;
  }

  .callout {
    color: var(--green);
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .link {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 600;
    text-decoration: none;
    color: var(--green);
  }

  .figure-wrap {
    margin-top: var(--space-6);
  }

  /*
    Figure.astro (frozen, shared) switches to its own two-column grid at
    min-width: 800px. This block's brief calls for stacking through 900px
    specifically, so the gap between 800-900px is closed here by a
    higher-specificity override on Figure's own class, without touching
    the shared component.
  */
  @media (min-width: 800px) and (max-width: 900px) {
    .four-weeks :global(.figure-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
