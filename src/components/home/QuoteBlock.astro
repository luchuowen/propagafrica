<section class="quote-block">
  <div class="wrap">
    <h2>Tell us the programme.</h2>
    <p>
      Crop, stage, annual volume and where it is delivered. That is enough for a first quotation,
      and we reply within one working day.
    </p>
    <a class="btn" href="/contact">
      Ask for a quotation
    </a>
    <p class="mono contact-line">+254 722 861 682 · info@propagafrica.com · NAIROBI, KENYA</p>
  </div>
</section>

<style>
  .quote-block {
    background: var(--green);
    color: var(--paper);
    padding: var(--space-7) 0;
  }

  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .quote-block h2 {
    color: var(--paper);
    max-width: 20em;
  }

  .quote-block p {
    margin-top: var(--space-3);
    max-width: 40em;
    color: var(--paper);
    opacity: 0.85;
  }

  .btn {
    display: inline-block;
    margin-top: var(--space-4);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 22px;
    background: var(--paper);
    color: var(--green);
    border: 1px solid var(--paper);
  }

  .btn:hover {
    opacity: 0.92;
  }

  .contact-line {
    margin-top: var(--space-4);
    opacity: 1;
    font-size: 11px;
    letter-spacing: 0.04em;
  }
</style>
