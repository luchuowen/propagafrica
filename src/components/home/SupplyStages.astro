---
import { Image } from 'astro:assets';

import prepareImg from '../../assets/images/tray-filling.jpg';
import graftImg from '../../assets/images/clips.jpg';
import rootImg from '../../assets/images/mist-bench.jpg';
import protectImg from '../../assets/images/hygiene-station.jpg';
import recordImg from '../../assets/images/records.jpg';

const STAGES = [
  {
    n: '01',
    slug: 'prepare',
    title: 'Prepare',
    line: 'The medium the cutting sits in, and the tray that holds it.',
    items: 'Vermiculite · Peat formulations · Trays 104–288 cell',
    img: prepareImg,
    alt: 'A nursery worker filling black propagation trays with dark peat at a potting bench',
  },
  {
    n: '02',
    slug: 'graft',
    title: 'Graft',
    line: 'Joining the two halves and holding them still while they knit together.',
    items: 'Silicone sleeves 1.5–12 mm bore · Clips in five profiles',
    img: graftImg,
    alt: 'An assortment of grafting clips and transparent sleeves on a weathered potting bench',
  },
  {
    n: '03',
    slug: 'root',
    title: 'Root',
    line: 'Keeping the leaf damp and the base drained for the weeks that follow.',
    items: 'Misting and fogging · Benching · Irrigation · Sensors',
    img: rootImg,
    alt: 'Overhead misting nozzles spraying a bench of young rose cuttings, backlit droplets in the air',
  },
  {
    n: '04',
    slug: 'protect',
    title: 'Protect',
    line: 'Keeping the house clean enough that nothing spreads through a whole batch.',
    items: 'Hypochlorite 10 % and 12 % · Footbaths · Tool stations · PPE',
    img: protectImg,
    alt: 'A footbath tray and tool dip station at the entrance to a propagation greenhouse',
  },
  {
    n: '05',
    slug: 'record',
    title: 'Record',
    line: 'Knowing which batch came from where, and being able to prove it later.',
    items: 'Loop labels · Batch cards · QC logbooks · Markers',
    img: recordImg,
    alt: 'An open duplicate logbook, batch cards and a bundle of loop labels on a greenhouse bench',
  },
];
---

<section class="stages">
  <div class="stages-head">
    <p class="eyebrow-warm">What we supply</p>
    <h2>Five stages, one order.</h2>
    <p class="lede">
      A nursery does not buy categories, it runs a sequence. We stock what each stage of that
      sequence consumes, so one order covers a month of work instead of five suppliers covering bits
      of it.
    </p>
  </div>

  <ul class="grid">
    {STAGES.map((s) => (
      <li class="card">
        <a href={`/supplies/${s.slug}`}>
          <span class="card-media">
            <Image
              src={s.img}
              alt={s.alt}
              widths={[400, 700]}
              sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 100vw"
              loading="lazy"
            />
          </span>
          <span class="card-body">
            <span class="card-n">{s.n}</span>
            <span class="card-title">{s.title}</span>
            <span class="card-line">{s.line}</span>
            <span class="card-items">{s.items}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <p class="stages-foot">
    One framework agreement &middot; monthly call-offs &middot; one delivery
  </p>
</section>

<style>
  .stages {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-7) var(--side-gutter);
  }

  .stages-head {
    max-width: 52ch;
  }

  .eyebrow-warm {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-ink);
    margin-bottom: var(--space-2);
  }

  .lede {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card a {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
  }

  .card a:hover {
    border-color: var(--green);
  }

  .card-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--green-pale);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    display: block;
    padding: var(--space-3);
  }

  .card-n {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .card-title {
    display: block;
    margin-top: 4px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.022em;
  }

  .card-line {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .card-items {
    display: block;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .stages-foot {
    margin-top: var(--space-4);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
