---
interface Stage {
  number: string;
  name: string;
  href: string;
  sentence: string;
  skus: string[];
}

const stages: Stage[] = [
  {
    number: '01',
    name: 'Prepare',
    href: '/supplies/prepare',
    sentence: 'Filling trays and getting the growing medium right, before anything is cut.',
    skus: [
      'PRO-VERM F · M · C',
      'PRO-PEAT SEED · PROP · GRAFT',
      'Trays 104–288 cell',
      'Pots, polybags, blades',
    ],
  },
  {
    number: '02',
    name: 'Graft',
    href: '/supplies/graft',
    sentence: 'Joining the two halves and holding them still while they knit together.',
    skus: ['PRO-ROSE 35 → 85', 'PRO-VEG · PRO-CUC · PRO-TREE', 'Clips: U, Omega, Round, Tomato, V'],
  },
  {
    number: '03',
    name: 'Root',
    href: '/supplies/root',
    sentence: 'Keeping the leaf damp and the base drained for the weeks that follow.',
    skus: [
      'Misting and fogging',
      'Benching and racking',
      'Drip, ebb and flow',
      'Shade, screening, LED',
      'Sensors and dashboard',
    ],
  },
  {
    number: '04',
    name: 'Protect',
    href: '/supplies/protect',
    sentence: 'Keeping the house clean enough that nothing spreads through a whole batch.',
    skus: [
      'PRO-SAN 10 · PRO-SAN 12',
      'Footbaths and tool stations',
      'Algae and biofilm control',
      'Sprayers, PPE',
    ],
  },
  {
    number: '05',
    name: 'Record',
    href: '/supplies/record',
    sentence: 'Knowing which batch came from where, and being able to prove it later.',
    skus: ['PRO-LABEL LOOP · T', 'PRO-TRACE · TRACE CARD', 'PRO-QC logbooks', 'PRO-MARK'],
  },
];
---

<section class="supply-stages">
  <div class="wrap">
    <p class="eyebrow">WHAT WE SUPPLY</p>
    <h2>Five stages, one order.</h2>
    <p class="intro">
      A nursery does not buy categories, it runs a sequence. We stock what each stage of that
      sequence consumes, so one order covers a month of work instead of five suppliers covering it
      between them.
    </p>
    <ol class="stage-list">
      {stages.map((stage) => (
        <li class="stage-row">
          <a href={stage.href}>
            <span class="stage-number mono">{stage.number}</span>
            <span class="stage-body">
              <h3 class="stage-name">{stage.name}</h3>
              <p class="stage-sentence">{stage.sentence}</p>
              <p class="stage-skus mono">
                {stage.skus.map((sku, i) => (
                  <>
                    {i > 0 ? ' · ' : ''}
                    <code>{sku}</code>
                  </>
                ))}
              </p>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p class="closing mono">ONE FRAMEWORK AGREEMENT · MONTHLY CALL-OFFS · ONE DELIVERY</p>
  </div>
</section>

<style>
  .supply-stages {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
  }

  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
  }

  .intro {
    margin-top: var(--space-2);
    max-width: 46em;
    color: var(--ink-soft);
  }

  .stage-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .stage-row a {
    display: grid;
    grid-template-columns: 2.5em 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }

  .stage-row:first-child a {
    border-top: none;
  }

  .stage-row a:hover .stage-name {
    color: var(--green);
  }

  .stage-number {
    font-size: 22px;
    color: var(--ink-soft);
  }

  .stage-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stage-name {
    font-size: 18px;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .stage-sentence {
    margin: 0;
    color: var(--ink-soft);
  }

  .stage-skus {
    margin: 4px 0 0;
    font-size: 11px;
    color: var(--ink-soft);
  }

  .stage-skus code {
    font-family: var(--f-mono);
  }

  .closing {
    margin-top: var(--space-4);
    color: var(--green);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
</style>
