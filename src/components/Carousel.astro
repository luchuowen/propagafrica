---
// Reusable carousel island. No external JS framework — a single scoped
// <script type="module"> initialises every instance found on the page, so
// this same component can run three times on one page (as the homepage will
// in a later session) with entirely different slide content. Do not put
// homepage-specific content, copy or styling in this file.
interface Slide {
  src: string;
  alt: string;
  caption?: string;
  step?: string;
}

interface Props {
  slides: Slide[];
  label: string;
  variant?: 'hero' | 'grid';
}

const { slides, label, variant = 'hero' } = Astro.props;
const lanes = variant === 'grid' ? 3 : 1;
const laneIndexes = Array.from({ length: lanes }, (_, i) => i);
const hasCaptions = slides.some((slide) => slide.caption);
---

<section
  class="pa-carousel"
  data-carousel
  data-variant={variant}
  data-interval="5500"
  aria-label={label}
  role="region"
>
  <div class="viewport">
    {laneIndexes.map((lane) => (
      <div class="lane" data-lane={lane}>
        <div class="media">
          {slides.map((slide, i) => (
            <div class:list={['frame', i === lane && 'is-active']} data-index={i}>
              <img
                src={slide.src}
                alt={slide.alt}
                loading={variant === 'hero' && lane === 0 && i === 0 ? 'eager' : 'lazy'}
                fetchpriority={variant === 'hero' && lane === 0 && i === 0 ? 'high' : undefined}
              />
            </div>
          ))}
          {/* Anchored to this lane's media box (not the whole card) so the
              arrows stay centred on the photo even when a caption panel
              beneath it changes the card's total height. */}
          {lane === 0 && slides.length > 1 && (
            <button type="button" class="control prev" aria-label="Previous slide">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M12.5 4 L7 10 L12.5 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>
          )}
          {/* A grid carousel only shows lane 0 below the 900px breakpoint
              (see the [data-variant='grid'] rule below), so its "next"
              button needs a mobile copy here too — hidden once the other
              lanes, and the real end-of-row button, appear. */}
          {lane === 0 && laneIndexes.length > 1 && slides.length > 1 && (
            <button type="button" class="control next next-mobile" aria-label="Next slide">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M7.5 4 L13 10 L7.5 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>
          )}
          {lane === laneIndexes.length - 1 && slides.length > 1 && (
            <button type="button" class="control next" aria-label="Next slide">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M7.5 4 L13 10 L7.5 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </button>
          )}
        </div>
        {hasCaptions && (
          <div class="caption-box">
            {slides.map(
              (slide, i) =>
                slide.caption && (
                  <p class:list={['caption', i === lane && 'is-active', slide.step && 'has-step']} data-index={i}>
                    {slide.step && <span class="step-num">{slide.step}</span>}
                    {slide.caption}
                  </p>
                ),
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .pa-carousel {
    position: relative;
  }

  .viewport {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: var(--space-2);
  }

  .lane {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
  }

  [data-variant='hero'] .viewport {
    gap: 0;
  }

  [data-variant='hero'] .lane {
    border-radius: 0;
  }

  /* Grid carousels (propagation journey, facilities-in-use) read as a row of
     photo cards, not a filmstrip — more air between them and enough radius
     and lift to separate each card from whatever sits behind it. */
  [data-variant='grid'] .viewport {
    gap: var(--space-3);
  }

  [data-variant='grid'] .lane {
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* Fallback fill while a slide's photo is still loading (large hero JPEGs on a slow
       connection), so a not-yet-painted image shows a dark, on-brand panel instead of the
       browser's default white/grey — reported as a "gray band" flash at the top of the hero. */
    background: var(--green-dark);
  }

  /* Below ~640px the hero copy (heading, standfirst, buttons) needs more
     room than a 16:9 crop of the photo gives it — the overlay text was
     overflowing the hero band and colliding with the section below. Drop
     the fixed aspect ratio there and guarantee enough height instead. */
  @media (max-width: 640px) {
    [data-variant='hero'] .media {
      aspect-ratio: auto;
      min-height: 560px;
    }
  }

  [data-variant='grid'] .lane:nth-child(n + 2) {
    display: none;
  }

  @media (min-width: 900px) {
    [data-variant='grid'] .lane:nth-child(n + 2) {
      display: block;
    }

    /* The end-of-row "next" button (in the now-visible last lane) takes
       over from the mobile copy once there is a real end of the row. */
    .control.next-mobile {
      display: none;
    }
  }

  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .frame.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* A slow, subtle zoom on hover — the one bit of "alive" motion a static
     documentary photo card can carry without turning into a gimmick. */
  @media (prefers-reduced-motion: no-preference) {
    [data-variant='grid'] .frame img {
      transition: transform 600ms ease;
    }

    [data-variant='grid'] .lane:hover .frame.is-active img {
      transform: scale(1.045);
    }
  }

  .control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    transition:
      transform 150ms ease,
      background 150ms ease;
  }

  .control.prev {
    left: var(--space-2);
  }

  .control.next {
    right: var(--space-2);
  }

  .control:hover {
    background: var(--mint);
    transform: translateY(-50%) scale(1.08);
  }

  /* The caption now lives on its own paper panel under the photo, not as a
     scrim overlaid on top of it — a translucent band over half the image
     read as cut-rate, and it hid part of every photo. Every caption in a
     lane is stacked in the same CSS grid cell so the panel's height comes
     from the tallest one (no fixed height, no JS measuring), and only the
     active caption is shown at a time via opacity, matching the photo
     crossfade above it. */
  .caption-box {
    display: grid;
  }

  .caption {
    grid-area: 1 / 1;
    margin: 0;
    padding: var(--space-3);
    color: var(--soft);
    font-family: var(--f-sans);
    font-size: 13.5px;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease;
  }

  /* Grid cards carry the caption on the same paper the card already sits
     on, with a hairline to mark where the photo ends — the panel reads as
     part of the card, not a loose line of text under a picture. */
  [data-variant='grid'] .caption-box {
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .caption.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* A numbered step (the propagation journey) reads as a sequence, not a
     photo credit — centre it and lead with a small ring-badge numeral in
     the site's spec-label mono, echoing the "01/02/03" numerals used for
     the outcome panels elsewhere on this page. */
  .caption.has-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding-block: var(--space-3);
    text-align: center;
    color: var(--ink);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    color: var(--soft);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .pa-carousel:focus-visible,
  .control:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
</style>

<script>
  // No attributes here deliberately: Astro then bundles and deduplicates this
  // script once per page, however many times <Carousel> is used on it (the
  // homepage uses it three times) — an attribute like type="module" would
  // make Astro treat it as inline and repeat it, and the query below,
  // running once per instance, would attach duplicate listeners to every
  // carousel already on the page.
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  carousels.forEach((root) => {
    const lanes = Array.from(root.querySelectorAll<HTMLElement>('.lane'));
    const slideCount = root.querySelectorAll('.lane:first-child .frame').length;
    if (slideCount === 0) return;

    const prevBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.control.prev'));
    const nextBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.control.next'));
    const interval = Number(root.dataset.interval || '5500');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // A grid carousel advances a whole lane's worth of slides at once, so
    // each tick swaps in a fresh, complete group (e.g. steps 1-3, then
    // 4-6) rather than sliding one slide at a time and leaving two of the
    // three lanes unchanged — which read as a stall, not a step forward,
    // for a numbered sequence like the propagation journey.
    const step = lanes.length;
    let index = 0;
    let timer: number | null = null;

    function render() {
      lanes.forEach((lane, laneOffset) => {
        const target = (index + laneOffset) % slideCount;
        const items = lane.querySelectorAll<HTMLElement>('[data-index]');
        items.forEach((item) => {
          item.classList.toggle('is-active', Number(item.dataset.index) === target);
        });
      });
    }

    function goTo(nextIndex: number) {
      index = ((nextIndex % slideCount) + slideCount) % slideCount;
      render();
    }

    function next() {
      goTo(index + step);
    }

    function prev() {
      goTo(index - step);
    }

    function stopAutoplay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay() {
      if (reducedMotion || slideCount < 2) return;
      stopAutoplay();
      timer = window.setInterval(next, interval);
    }

    // A manual nudge (arrow, keyboard, swipe) resets the timer rather than
    // killing it for good, so the carousel keeps advancing on its own
    // afterwards instead of going static the moment someone touches it.
    function onUserInteraction(action: () => void) {
      stopAutoplay();
      action();
      startAutoplay();
    }

    prevBtns.forEach((btn) => btn.addEventListener('click', () => onUserInteraction(prev)));
    nextBtns.forEach((btn) => btn.addEventListener('click', () => onUserInteraction(next)));

    root.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowLeft') {
        event.preventDefault();
        onUserInteraction(prev);
      } else if (key === 'ArrowRight') {
        event.preventDefault();
        onUserInteraction(next);
      }
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    let touchStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = (event as TouchEvent).touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const endX = (event as TouchEvent).changedTouches[0]?.clientX ?? touchStartX;
        const delta = endX - touchStartX;
        touchStartX = null;
        if (Math.abs(delta) < 40) return;
        onUserInteraction(delta < 0 ? next : prev);
      },
      { passive: true },
    );

    render();
    startAutoplay();
  });
</script>
