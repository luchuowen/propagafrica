---
// Reusable carousel island. No external JS framework — a single scoped
// <script type="module"> initialises every instance found on the page, so
// this same component can run three times on one page (as the homepage will
// in a later session) with entirely different slide content. Do not put
// homepage-specific content, copy or styling in this file.
interface Slide {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  label: string;
  variant?: 'hero' | 'grid';
}

const { slides, label, variant = 'hero' } = Astro.props;
const lanes = variant === 'grid' ? 3 : 1;
const laneIndexes = Array.from({ length: lanes }, (_, i) => i);
---

<section
  class="pa-carousel"
  data-carousel
  data-variant={variant}
  data-interval="5500"
  aria-label={label}
  role="region"
>
  <div class="viewport">
    {laneIndexes.map((lane) => (
      <div class="lane" data-lane={lane}>
        {slides.map((slide, i) => (
          <figure class:list={['slide', i === lane && 'is-active']} data-index={i}>
            <img
              src={slide.src}
              alt={slide.alt}
              loading={lane === 0 && i === 0 ? 'eager' : 'lazy'}
            />
            {slide.caption && <figcaption>{slide.caption}</figcaption>}
          </figure>
        ))}
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button type="button" class="control prev" aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M12.5 4 L7 10 L12.5 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button type="button" class="control next" aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M7.5 4 L13 10 L7.5 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <div class="dots">
        {slides.map((slide, i) => (
          <button
            type="button"
            class="dot"
            data-index={i}
            aria-current={i === 0 ? 'true' : undefined}
            aria-label={`Go to slide ${i + 1}: ${slide.alt}`}
          ></button>
        ))}
      </div>
    </>
  )}
</section>

<style>
  .pa-carousel {
    position: relative;
  }

  .viewport {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: var(--space-2);
  }

  .lane {
    position: relative;
    flex: 1 1 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-m);
  }

  [data-variant='hero'] .viewport {
    gap: 0;
  }

  [data-variant='hero'] .lane {
    aspect-ratio: 16 / 9;
    border-radius: 0;
  }

  [data-variant='grid'] .lane:nth-child(n + 2) {
    display: none;
  }

  @media (min-width: 900px) {
    [data-variant='grid'] .lane:nth-child(n + 2) {
      display: block;
    }
  }

  .slide {
    margin: 0;
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .slide.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slide figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-3);
    color: var(--white);
    background-color: var(--ink-overlay);
    font-size: 14px;
  }

  .control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .control.prev {
    left: var(--space-2);
  }

  .control.next {
    right: var(--space-2);
  }

  .control:hover {
    background: var(--mint);
  }

  .dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-2);
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--white);
    opacity: 0.55;
    cursor: pointer;
  }

  .dot[aria-current='true'] {
    opacity: 1;
    background: var(--gold);
  }

  .pa-carousel:focus-visible,
  .control:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
</style>

<script>
  // No attributes here deliberately: Astro then bundles and deduplicates this
  // script once per page, however many times <Carousel> is used on it (the
  // homepage uses it three times) — an attribute like type="module" would
  // make Astro treat it as inline and repeat it, and the query below,
  // running once per instance, would attach duplicate listeners to every
  // carousel already on the page.
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  carousels.forEach((root) => {
    const lanes = Array.from(root.querySelectorAll<HTMLElement>('.lane'));
    const slideCount = root.querySelectorAll('.lane:first-child .slide').length;
    if (slideCount === 0) return;

    const prevBtn = root.querySelector<HTMLButtonElement>('.control.prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.control.next');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const interval = Number(root.dataset.interval || '5500');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let userInteracted = false;
    let timer: number | null = null;

    function render() {
      lanes.forEach((lane, laneOffset) => {
        const target = (index + laneOffset) % slideCount;
        const slides = lane.querySelectorAll<HTMLElement>('.slide');
        slides.forEach((slide) => {
          slide.classList.toggle('is-active', Number(slide.dataset.index) === target);
        });
      });
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function goTo(nextIndex: number) {
      index = ((nextIndex % slideCount) + slideCount) % slideCount;
      render();
    }

    function next() {
      goTo(index + 1);
    }

    function prev() {
      goTo(index - 1);
    }

    function stopAutoplay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay() {
      if (reducedMotion || userInteracted || slideCount < 2) return;
      stopAutoplay();
      timer = window.setInterval(next, interval);
    }

    function onUserInteraction(action: () => void) {
      userInteracted = true;
      stopAutoplay();
      action();
    }

    prevBtn?.addEventListener('click', () => onUserInteraction(prev));
    nextBtn?.addEventListener('click', () => onUserInteraction(next));
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => onUserInteraction(() => goTo(i)));
    });

    root.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowLeft') {
        event.preventDefault();
        onUserInteraction(prev);
      } else if (key === 'ArrowRight') {
        event.preventDefault();
        onUserInteraction(next);
      }
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    let touchStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = (event as TouchEvent).touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const endX = (event as TouchEvent).changedTouches[0]?.clientX ?? touchStartX;
        const delta = endX - touchStartX;
        touchStartX = null;
        if (Math.abs(delta) < 40) return;
        onUserInteraction(delta < 0 ? next : prev);
      },
      { passive: true },
    );

    render();
    startAutoplay();
  });
</script>
