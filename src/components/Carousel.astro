---
// Reusable carousel island. No external JS framework — a single scoped
// <script type="module"> initialises every instance found on the page, so
// this same component can run three times on one page (as the homepage will
// in a later session) with entirely different slide content. Do not put
// homepage-specific content, copy or styling in this file.
interface Slide {
  src: string;
  alt: string;
  caption?: string;
  step?: string;
}

interface Props {
  slides: Slide[];
  label: string;
  variant?: 'hero' | 'grid';
}

const { slides, label, variant = 'hero' } = Astro.props;
const lanes = variant === 'grid' ? 3 : 1;
const laneIndexes = Array.from({ length: lanes }, (_, i) => i);
const hasCaptions = slides.some((slide) => slide.caption);

// Every carousel photo ships at a fixed size per docs/image-manifest.md
// (hero: 1920x1080, journey/facilities: 1200x900) — width/height here avoid
// layout shift, and the srcset below leans on scripts/generate-image-variants.mjs
// (wired into the astro:build:done hook) generating a WebP copy plus a 640w
// WebP + same-format fallback alongside every source photo in dist/.
const nativeWidth = variant === 'hero' ? 1920 : 1200;
const nativeHeight = variant === 'hero' ? 1080 : 900;
const sizes = variant === 'hero' ? '100vw' : '(min-width: 900px) 33vw, 100vw';

function assetVariants(src: string) {
  const match = src.match(/\.(jpe?g|png)$/i);
  const ext = match ? match[0] : '.jpg';
  const base = src.slice(0, -ext.length);
  return {
    webp: `${base}.webp`,
    webpSmall: `${base}-640.webp`,
    fallbackSmall: `${base}-640${ext}`,
  };
}
---

<section
  class="pa-carousel"
  data-carousel
  data-variant={variant}
  data-interval="5500"
  aria-label={label}
  role="region"
>
  {variant === 'grid' && slides.length > 1 && (
    <div class="rail">
      <button type="button" class="control prev" aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M12.5 4 L7 10 L12.5 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <button type="button" class="control next" aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M7.5 4 L13 10 L7.5 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  )}
  <div class="viewport">
    {laneIndexes.map((lane) => (
      <div class="lane" data-lane={lane}>
        <div class="media">
          {slides.map((slide, i) => {
            const { webp, webpSmall, fallbackSmall } = assetVariants(slide.src);
            const isFirstPaint = variant === 'hero' && lane === 0 && i === 0;
            return (
              <div class:list={['frame', i === lane && 'is-active']} data-index={i}>
                <picture>
                  <source
                    type="image/webp"
                    srcset={`${webpSmall} 640w, ${webp} ${nativeWidth}w`}
                    sizes={sizes}
                  />
                  <img
                    src={slide.src}
                    srcset={`${fallbackSmall} 640w, ${slide.src} ${nativeWidth}w`}
                    sizes={sizes}
                    width={nativeWidth}
                    height={nativeHeight}
                    alt={slide.alt}
                    loading={isFirstPaint ? 'eager' : 'lazy'}
                    fetchpriority={isFirstPaint ? 'high' : undefined}
                    decoding={isFirstPaint ? 'sync' : 'async'}
                  />
                </picture>
              </div>
            );
          })}
          {/* Overlay arrow buttons read as dated slideshow chrome. A tap or
              swipe already moves the hero along (see the script below); this
              dot row is the one visible control — click a dot to jump
              straight to that slide, with the active one drawn as a pill so
              position is legible at a glance. */}
          {variant === 'hero' && lane === 0 && slides.length > 1 && (
            <div class="dots" role="group" aria-label="Choose a slide">
              {slides.map((_, i) => (
                <button
                  type="button"
                  class:list={['dot', i === 0 && 'is-active']}
                  data-dot={i}
                  aria-label={`Go to slide ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
          )}
        </div>
        {hasCaptions && (
          <div class="caption-box">
            {slides.map(
              (slide, i) =>
                slide.caption && (
                  <p
                    class:list={['caption', i === lane && 'is-active', slide.step && 'has-step']}
                    data-index={i}
                  >
                    {slide.step && <span class="step-num">{slide.step}</span>}
                    {variant === 'grid' && !slide.step && (
                      <span class="cap-idx">
                        {String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
                      </span>
                    )}
                    {slide.caption}
                  </p>
                ),
            )}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .pa-carousel {
    position: relative;
  }

  .viewport {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: var(--space-2);
  }

  .lane {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
  }

  [data-variant='hero'] .viewport {
    gap: 0;
  }

  [data-variant='hero'] .lane {
    border-radius: 0;
  }

  /* Grid carousels read as a row of photo cards, not a filmstrip. The card is
     a white mount with the photograph inset on it — the same plate the product
     grid uses — rather than a paper block with the photograph bled to its
     edge. The arrows live on the rail above, never over a photograph. */
  [data-variant='grid'] .viewport {
    gap: var(--space-3);
    overflow: visible;
  }

  [data-variant='grid'] .lane {
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    padding: 10px;
    background: var(--white);
  }

  [data-variant='grid'] .media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-variant='grid'] .lane {
      transition:
        transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1),
        box-shadow 300ms ease;
    }

    [data-variant='grid'] .lane:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-soft);
    }
  }

  /* The arrow rail sits above the row, right-aligned under the section
     heading, so no control ever covers part of a photograph. */
  .rail {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: var(--space-3);
  }

  /* From 900px the rail rides up beside the section heading rather than
     sitting on a line of its own. The heading blocks this component is used
     under are all width-capped well short of the right edge, so the two never
     meet; below 900px the heading can run full width, and the rail stays on
     its own row. */
  @media (min-width: 900px) {
    .rail {
      margin-top: -76px;
    }
  }

  .rail .control {
    position: static;
    transform: none;
    width: 44px;
    height: 44px;
    background: var(--white);
    border: 1px solid var(--rule);
    color: var(--green);
    box-shadow: none;
  }

  .rail .control:hover {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
    transform: none;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* Fallback fill while a slide's photo is still loading (large hero JPEGs on a slow
       connection), so a not-yet-painted image shows a dark, on-brand panel instead of the
       browser's default white/grey — reported as a "gray band" flash at the top of the hero. */
    background: var(--green-dark);
  }

  /* Below ~640px the hero copy (heading, standfirst, buttons) needs more
     room than a 16:9 crop of the photo gives it — the overlay text was
     overflowing the hero band and colliding with the section below. Drop
     the fixed aspect ratio there and guarantee enough height instead. */
  @media (max-width: 640px) {
    [data-variant='hero'] .media {
      aspect-ratio: auto;
      min-height: 560px;
    }
  }

  /* A 16:9 crop at full viewport width is nearly a 100vh hero on laptop
     screens (a forbidden pattern — CLAUDE.md invariants) — 1440px wide gives
     810px tall, leaving nothing else on screen at first paint. From here up,
     size the band off the viewport height instead of the photo's aspect
     ratio, capped so it stays a band rather than filling the window: the
     object-fit: cover crop on .frame img absorbs whatever ratio results. */
  @media (min-width: 641px) {
    [data-variant='hero'] .media {
      aspect-ratio: auto;
      height: clamp(480px, 64vh, 640px);
    }
  }

  [data-variant='grid'] .lane:nth-child(n + 2) {
    display: none;
  }

  @media (min-width: 900px) {
    [data-variant='grid'] .lane:nth-child(n + 2) {
      display: block;
    }

    /* The end-of-row "next" button (in the now-visible last lane) takes
       over from the mobile copy once there is a real end of the row. */
    .control.next-mobile {
      display: none;
    }
  }

  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .frame.is-active {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  .frame picture,
  .frame img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .frame img {
    object-fit: cover;
  }

  /* A slow, subtle zoom on hover — the one bit of "alive" motion a static
     documentary photo card can carry without turning into a gimmick. */
  @media (prefers-reduced-motion: no-preference) {
    [data-variant='grid'] .frame img {
      transition: transform 600ms ease;
    }

    [data-variant='grid'] .lane:hover .frame.is-active img {
      transform: scale(1.045);
    }
  }

  /* Ken Burns drift on the hero only — a slow, continuous zoom-and-pan for
     as long as a slide is on screen, run on the <img> itself so it layers
     under (not instead of) .frame's own crossfade/scale entrance above.
     Duration outlasts the 5.5s autoplay interval so it never visibly
     settles into a static frame before the next slide crossfades in.
     Direction alternates by slide (even/odd) so five slides in a row don't
     all drift the same way. Skipped entirely under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    [data-variant='hero'] .frame img {
      transform-origin: 50% 50%;
    }

    [data-variant='hero'] .frame.is-active img {
      animation: ken-burns-a 9s ease-out forwards;
    }

    [data-variant='hero'] .frame:nth-child(even).is-active img {
      animation-name: ken-burns-b;
    }

    @keyframes ken-burns-a {
      from {
        transform: scale(1) translate(0, 0);
      }

      to {
        transform: scale(1.12) translate(-1.6%, -1.2%);
      }
    }

    @keyframes ken-burns-b {
      from {
        transform: scale(1) translate(0, 0);
      }

      to {
        transform: scale(1.12) translate(1.6%, 1%);
      }
    }
  }

  .control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    transition:
      transform 150ms ease,
      background 150ms ease;
  }

  .control.prev {
    left: var(--space-2);
  }

  .control.next {
    right: var(--space-2);
  }

  .control:hover {
    background: var(--mint);
    transform: translateY(-50%) scale(1.08);
  }

  /* Replaces the hero's old overlay prev/next buttons — a row of small
     dots a tap or click can jump to directly, low enough in contrast to
     read as a position marker rather than UI chrome sitting on the photo.
     Each button is a full 24x24px hit target (Lighthouse's target-size
     minimum) with the visible dot drawn smaller, centred, via ::after —
     the touch area is generous without the marker itself looking heavy. */
  .dots {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--space-2);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
  }

  .dot {
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .dot::after {
    content: '';
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
  }

  .dot:hover::after {
    background: rgba(255, 255, 255, 0.75);
  }

  .dot.is-active::after {
    width: 22px;
    background: var(--paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      transition:
        width 250ms ease,
        background-color 200ms ease;
    }
  }

  /* The caption now lives on its own paper panel under the photo, not as a
     scrim overlaid on top of it — a translucent band over half the image
     read as cut-rate, and it hid part of every photo. Every caption in a
     lane is stacked in the same CSS grid cell so the panel's height comes
     from the tallest one (no fixed height, no JS measuring), and only the
     active caption is shown at a time via opacity, matching the photo
     crossfade above it. */
  .caption-box {
    display: grid;
  }

  .caption {
    grid-area: 1 / 1;
    margin: 0;
    padding: var(--space-3);
    color: var(--soft);
    font-family: var(--f-sans);
    font-size: 13.5px;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease;
  }

  /* The caption sits on the card's own white, led by a mono index. That index
     is the whole position marker: a progress rule under the row lit three
     segments of eight, which said nothing the cards were not already saying
     and read as a broken bar. */
  [data-variant='grid'] .caption {
    padding: var(--space-3) 14px 10px;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.55;
  }

  .cap-idx {
    display: block;
    margin-bottom: var(--space-1);
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--soft);
  }

  @media (max-width: 640px) {
    [data-variant='grid'] .caption {
      text-align: center;
    }
  }

  .caption.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* A numbered step (the propagation journey) reads as a sequence, not a
     photo credit — centre it and lead with a small ring-badge numeral in
     the site's spec-label mono, echoing the "01/02/03" numerals used for
     the outcome panels elsewhere on this page. */
  .caption.has-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding-block: var(--space-3);
    text-align: center;
    color: var(--ink);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    color: var(--soft);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .pa-carousel:focus-visible,
  .control:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
</style>

<script>
  // No attributes here deliberately: Astro then bundles and deduplicates this
  // script once per page, however many times <Carousel> is used on it (the
  // homepage uses it three times) — an attribute like type="module" would
  // make Astro treat it as inline and repeat it, and the query below,
  // running once per instance, would attach duplicate listeners to every
  // carousel already on the page.
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  carousels.forEach((root) => {
    const lanes = Array.from(root.querySelectorAll<HTMLElement>('.lane'));
    const slideCount = root.querySelectorAll('.lane:first-child .frame').length;
    if (slideCount === 0) return;

    const prevBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.control.prev'));
    const nextBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.control.next'));
    const dotBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const interval = Number(root.dataset.interval || '5500');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // A grid carousel advances a whole lane's worth of slides at once, so
    // each tick swaps in a fresh, complete group (e.g. steps 1-3, then
    // 4-6) rather than sliding one slide at a time and leaving two of the
    // three lanes unchanged — which read as a stall, not a step forward,
    // for a numbered sequence like the propagation journey.
    const step = lanes.length;
    let index = 0;
    let timer: number | null = null;

    function render() {
      lanes.forEach((lane, laneOffset) => {
        const target = (index + laneOffset) % slideCount;
        const items = lane.querySelectorAll<HTMLElement>('[data-index]');
        items.forEach((item) => {
          item.classList.toggle('is-active', Number(item.dataset.index) === target);
        });
      });
      dotBtns.forEach((dot) => {
        const isActive = Number(dot.dataset.dot) === index;
        dot.classList.toggle('is-active', isActive);
        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function goTo(nextIndex: number) {
      index = ((nextIndex % slideCount) + slideCount) % slideCount;
      render();
    }

    function next() {
      goTo(index + step);
    }

    function prev() {
      goTo(index - step);
    }

    function stopAutoplay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay() {
      if (reducedMotion || slideCount < 2) return;
      stopAutoplay();
      timer = window.setInterval(next, interval);
    }

    // A manual nudge (arrow, keyboard, swipe) resets the timer rather than
    // killing it for good, so the carousel keeps advancing on its own
    // afterwards instead of going static the moment someone touches it.
    function onUserInteraction(action: () => void) {
      stopAutoplay();
      action();
      startAutoplay();
    }

    prevBtns.forEach((btn) => btn.addEventListener('click', () => onUserInteraction(prev)));
    nextBtns.forEach((btn) => btn.addEventListener('click', () => onUserInteraction(next)));
    dotBtns.forEach((dot) => {
      dot.addEventListener('click', () => onUserInteraction(() => goTo(Number(dot.dataset.dot))));
    });

    root.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowLeft') {
        event.preventDefault();
        onUserInteraction(prev);
      } else if (key === 'ArrowRight') {
        event.preventDefault();
        onUserInteraction(next);
      }
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    let touchStartX: number | null = null;
    root.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = (event as TouchEvent).touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    root.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const endX = (event as TouchEvent).changedTouches[0]?.clientX ?? touchStartX;
        const delta = endX - touchStartX;
        touchStartX = null;
        if (Math.abs(delta) < 40) return;
        onUserInteraction(delta < 0 ? next : prev);
      },
      { passive: true },
    );

    render();

    // Autoplay waits until the carousel is actually on screen. It used to start
    // at page load, so a carousel far down the page had already advanced by the
    // time it was scrolled to and opened on, say, 04 / 08 — the numbering made
    // that look like a bug. Now the first thing anyone sees is 01.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            startAutoplay();
          });
        },
        { threshold: 0.25 },
      );
      io.observe(root);
    } else {
      startAutoplay();
    }
  });
</script>
