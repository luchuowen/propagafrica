---
// Site header: wordmark, primary navigation, persistent quotation CTA.
// Below 720px (the breakpoint every other section on the site collapses at)
// the nav collapses behind a hamburger toggle and the wordmark centres.
import Wordmark from './Wordmark.astro';
import { NAV_ITEMS, isActive } from '../lib/nav';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <button
      type="button"
      class="hamburger"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav-panel"
      aria-label="Open menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <div class="header-logo">
      <Wordmark />
    </div>

    <div class="nav-panel" id="primary-nav-panel">
      <nav aria-label="Primary">
        <ul>
          {NAV_ITEMS.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="cta btn" href="/contact/">
        Request a Quotation
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const panel = document.querySelector<HTMLElement>('#primary-nav-panel');
  const header = toggle?.closest<HTMLElement>('.site-header');

  if (toggle && panel && header) {
    const setOpen = (isOpen: boolean) => {
      header.classList.toggle('nav-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('nav-open'));
    });

    // A tap on a nav link or the CTA should close the panel, not leave it
    // open behind the page the link just navigated to.
    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('nav-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-2) var(--side-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .header-logo {
    display: flex;
  }

  .hamburger {
    display: none;
  }

  .nav-panel {
    display: contents;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  nav a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--green);
  }

  nav a:active {
    opacity: 0.7;
  }

  .cta {
    text-decoration: none;
    background: var(--green);
    color: var(--paper);
    font-weight: 700;
    font-size: 14px;
    padding: 10px 18px;
    border: 1px solid var(--green);
    border-radius: var(--radius-s);
    white-space: nowrap;
  }

  .cta:hover {
    opacity: 0.92;
  }

  @media (max-width: 720px) {
    .header-inner {
      display: grid;
      grid-template-columns: 40px 1fr 40px;
      align-items: center;
      column-gap: var(--space-2);
      row-gap: 0;
    }

    /* The empty first column mirrors the hamburger's column so the wordmark
       lands on the true centre, not the centre of the space left of it. */
    .hamburger {
      grid-column: 3;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 0;
      background: transparent;
      border: 1px solid var(--rule);
      border-radius: var(--radius-s);
      cursor: pointer;
    }

    .hamburger-bar {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--ink);
      transition:
        transform 0.15s ease,
        opacity 0.15s ease;
    }

    .site-header.nav-open .hamburger-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .site-header.nav-open .hamburger-bar:nth-child(2) {
      opacity: 0;
    }

    .site-header.nav-open .hamburger-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .header-logo {
      grid-column: 2;
      grid-row: 1;
      justify-content: center;
    }

    .nav-panel {
      display: none;
      grid-column: 1 / -1;
      grid-row: 2;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding-top: var(--space-3);
      margin-top: var(--space-2);
      border-top: 1px solid var(--rule);
    }

    .site-header.nav-open .nav-panel {
      display: flex;
    }

    nav ul {
      flex-direction: column;
      gap: var(--space-2);
    }

    .cta {
      text-align: center;
    }
  }
</style>
