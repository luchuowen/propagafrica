---
// Site header: wordmark, primary navigation, persistent quotation CTA.
import Wordmark from './Wordmark.astro';
import { NAV_ITEMS, isActive } from '../lib/nav';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <Wordmark />
    <nav aria-label="Primary">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="cta btn" href="/contact/">
      Request a Quotation
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-2) var(--side-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  nav a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--green);
  }

  .cta {
    text-decoration: none;
    background: var(--green);
    color: var(--paper);
    font-weight: 700;
    font-size: 14px;
    padding: 10px 18px;
    border: 1px solid var(--green);
    white-space: nowrap;
  }

  .cta:hover {
    opacity: 0.92;
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
