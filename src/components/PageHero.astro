---
// The page header for every route except the home page.
//
// This replaces the drawing-sheet title block that used to sit at the top of
// each page (DRAWING PA-004 / SUBJECT / SHEET 04 OF 14). That device made the
// whole site read as equipment documentation rather than as a website, which
// is the single change this rebuild is for. Where a page has a photograph it
// runs full-bleed behind the heading; where it does not, the heading sits on
// paper with a hairline under it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  standfirst?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, standfirst, image, imageAlt } = Astro.props;
const hasImage = Boolean(image);
---

<header class:list={['page-hero', hasImage && 'has-image']}>
  {image && (
    <div class="hero-media">
      <Image
        src={image}
        alt={imageAlt ?? ''}
        widths={[800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}
  <div class="hero-body">
    <div class="hero-inner">
      <p class="hero-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {standfirst && <p class="hero-standfirst">{standfirst}</p>}
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--green-deep);
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink-overlay-strong);
  }

  .hero-body {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter) var(--space-5);
  }

  .has-image .hero-body {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
    min-height: 42vh;
    display: flex;
    align-items: flex-end;
  }

  .hero-inner {
    max-width: 720px;
  }

  .hero-eyebrow {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal-ink);
    margin-bottom: var(--space-2);
  }

  .hero-standfirst {
    margin-top: var(--space-3);
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  /* Reversed out over a photograph. */
  .has-image h1,
  .has-image .hero-standfirst {
    color: var(--paper);
  }

  .has-image .hero-eyebrow {
    color: var(--paper);
    opacity: 0.8;
  }

  .has-image .hero-standfirst {
    opacity: 0.9;
  }

  /* Without a photograph, a hairline carries the break instead. */
  .page-hero:not(.has-image) {
    border-bottom: 1px solid var(--rule);
  }

  /* Mobile only — .hero-inner's own max-width doesn't bind below that width
     (the box is already full-width there), so text-align alone is enough
     to centre everything inside it. */
  @media (max-width: 640px) {
    .hero-inner {
      text-align: center;
    }
  }
</style>
