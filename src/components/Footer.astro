---
// Site footer. Four columns per the shadcn-inspired brief Owen supplied — reimplemented in this
// project's own Astro + plain-CSS system rather than pulling in React/Tailwind/shadcn, which the
// rest of the codebase doesn't use. Nav column reuses the canonical NAV_ITEMS so it can never
// disagree with the header. Social links point at "#" until Owen has real accounts to name —
// they are styled as live buttons (hover fill, focus ring, press) rather than dead text, and
// carry the official brand marks. The newsletter form posts to a real Cloud
// Function (subscribeNewsletter, see functions/src/index.ts) via the same progressive-enhancement
// pattern as QuoteForm.astro. The baseline row (copyright, designer credit, strap line) is locked
// copy from blueprint.md's Global section — do not reword it.
import Wordmark from './Wordmark.astro';
import { NAV_ITEMS } from '../lib/nav';
import { HONEYPOT_FIELD, TIMESTAMP_FIELD } from '../lib/quotation/schema';

const year = new Date().getFullYear();

// One sitemap column, in header order, from the same NAV_ITEMS the header
// uses — so labels and order can't drift. It was two columns ("Explore" and
// "Company"); the second held two links, which left it reading as a stub next
// to the others.

// Official brand marks, as filled 24x24 paths. These were hand-drawn stroked
// approximations in a 20x20 box: the Instagram badge was a plain square with a
// stray dot, the Facebook "f" was a bare stroke, and the X mark was a literal
// multiply sign rather than X.com's angular logo. At 16px stroked they were
// also too small to identify at a glance.
const SOCIALS = [
  {
    name: 'Instagram',
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.77-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.77.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38a5.9 5.9 0 0 0 1.38-2.13c.3-.77.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.77-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.41a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z',
  },
  {
    name: 'Facebook',
    path: 'M24 12a12 12 0 1 0-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.88V12h3.33l-.53 3.47h-2.8v8.38A12 12 0 0 0 24 12Z',
  },
  {
    name: 'LinkedIn',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  },
  {
    name: 'X',
    path: 'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.25 6.93 6.06-6.93Zm-1.29 19.49h2.04L6.49 3.24H4.3l13.31 17.4Z',
  },
] as const;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid" data-reveal-group>
      <div class="footer-col footer-company" data-reveal>
        <Wordmark markSize={26} />
        <p class="blurb">
          Grafting tubes, clips, nursery consumables and propagation systems for commercial growers
          across Africa, with technical support and regional stock hubs in Kenya and Ethiopia.
        </p>
        <address>
          <a href="tel:+254722861682">+254 722 861 682</a>
          <br />
          <a href="mailto:info@propagafrica.com">info@propagafrica.com</a>
        </address>
        <ul class="social-list">
          {SOCIALS.map((social) => (
            <li>
              <a class="social-icon" href="#" aria-label={social.name}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-sitemap" data-reveal>
        <!-- A button + class toggle, not <details>: Chromium excludes a closed
             <details>'s content from the Tab order even when an author style
             forces it to paint (offsetParent is non-null, but it's still
             unreachable by keyboard) — a real accessibility regression a
             `display: flex !important` override can't fix. This mirrors the
             header's own hamburger toggle instead. The list is the tallest
             thing in a stacked mobile footer, so it starts closed there; the
             toggle button only becomes interactive below 720px — on desktop
             it's a static label and the list stays open. -->
        <p class="eyebrow sitemap-label">Sitemap</p>
        <button
          type="button"
          class="sitemap-toggle eyebrow"
          id="sitemap-toggle"
          aria-expanded="false"
          aria-controls="sitemap-list"
        >
          Sitemap
          <span class="sitemap-chevron" aria-hidden="true"></span>
        </button>
        <ul id="sitemap-list">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-actions" data-reveal>
        <div class="action-panel">
          <div class="action-top">
            <p class="eyebrow">Newsletter</p>
            <p class="blurb">Occasional notes on stock, seasons and new product lines.</p>

            <form
              id="newsletter-form"
              class="newsletter-form"
              method="post"
              action="/api/subscribe-newsletter"
            >
              <label for="newsletter-email" class="sr-only">
                Email address
              </label>
              <div class="newsletter-row">
                <input
                  id="newsletter-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@company.com"
                  maxlength="254"
                  required
                  aria-describedby="newsletter-status"
                />
                <button type="submit" class="newsletter-submit">
                  Subscribe
                </button>
              </div>

              <div class="honeypot" aria-hidden="true">
                {/* The quotation form carries a honeypot with the same field name,
                    and the footer renders on that page too — so the id here is
                    prefixed to keep it unique in the document. The name is what
                    the script and the endpoint read, and it is unchanged. */}
                <label for={`newsletter-${HONEYPOT_FIELD}`}>Leave this field blank</label>
                <input
                  id={`newsletter-${HONEYPOT_FIELD}`}
                  name={HONEYPOT_FIELD}
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              <input type="hidden" id={TIMESTAMP_FIELD} name={TIMESTAMP_FIELD} value="" />

              <p
                id="newsletter-status"
                class="newsletter-status"
                role="alert"
                aria-live="assertive"
              ></p>
            </form>
          </div>

          <div class="action-bottom">
            <hr class="action-rule" />

            <p class="blurb">Ready to order? Tell us your crop, volume and site.</p>
            <a class="footer-cta" href="/contact/">
              Request a Quotation
              <span class="btn-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-baseline">
      <p class="baseline-row">
        <span>&copy; {year} PropagAfrica Technologies</span>
        <span class="strapline">Together we grow Africa&rsquo;s horticulture.</span>
        <a class="credit" href="https://navac.co.ke">
          <span class="credit-label">Designed by</span>{' '}
          <span class="credit-brand">NAVAC GLOBAL</span>
        </a>
      </p>
    </div>
  </div>
</footer>

<script>
  import { HONEYPOT_FIELD, TIMESTAMP_FIELD } from '../lib/quotation/schema';

  const sitemapToggle = document.querySelector<HTMLButtonElement>('#sitemap-toggle');
  const sitemapList = document.querySelector<HTMLElement>('#sitemap-list');
  if (sitemapToggle && sitemapList) {
    sitemapToggle.addEventListener('click', () => {
      const isOpen = sitemapList.classList.toggle('is-open');
      sitemapToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }

  const GENERIC_ERROR = 'That did not send. Check your connection and try again.';

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('newsletter-status');
  if (form && statusEl) {
    const tsInput = form.elements.namedItem(TIMESTAMP_FIELD) as HTMLInputElement | null;
    if (tsInput) tsInput.value = String(Date.now());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      statusEl.textContent = '';
      statusEl.classList.remove('is-error');

      const honeypot = form.elements.namedItem(HONEYPOT_FIELD) as HTMLInputElement | null;
      if (honeypot && honeypot.value.trim() !== '') {
        // Bot filled the trap. Pretend success and stop — never tip it off.
        form.reset();
        statusEl.textContent = 'Subscribed.';
        return;
      }

      const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
      if (emailInput && !emailInput.checkValidity()) {
        statusEl.textContent = 'Enter a valid email address.';
        statusEl.classList.add('is-error');
        emailInput.focus();
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) submitButton.disabled = true;

      try {
        const formData = new FormData(form);
        const payload = {
          email: formData.get('email') ?? '',
          [HONEYPOT_FIELD]: formData.get(HONEYPOT_FIELD) ?? '',
          [TIMESTAMP_FIELD]: formData.get(TIMESTAMP_FIELD) ?? '',
        };

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null);

        if (response.ok && result?.ok) {
          form.reset();
          statusEl.textContent = 'You’re subscribed.';
        } else {
          statusEl.textContent = result?.message ?? GENERIC_ERROR;
          statusEl.classList.add('is-error');
        }
      } catch {
        statusEl.textContent = GENERIC_ERROR;
        statusEl.classList.add('is-error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter) var(--space-3);
  }

  /* Three zones: the brand block, one sitemap column, and both actions boxed
     together in a panel on the right. It was five columns of very unequal
     weight, which left the four short ones floating beside a brand column
     twice their height. */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: var(--space-5);
  }

  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    /* The action panel takes the full width under the other two until there
       is room for a third track. */
    .footer-actions {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: 1.1fr 0.75fr 1.15fr;
      gap: var(--space-5);
    }

    .footer-actions {
      grid-column: auto;
      /* The grid's own align-items: start would otherwise leave the panel as
         tall as its own content — stretch it to match the brand column (the
         tallest of the three) instead of ending short of the social icons. */
      align-self: stretch;
    }
  }

  .footer-col {
    /* Without this, a grid item defaults to min-width: auto (its content's natural width),
       so the newsletter row's input+button can force the whole grid wider than the viewport
       on narrow screens instead of shrinking to fit the column. */
    min-width: 0;
  }

  .footer-col ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Hidden outside the mobile breakpoint — same as the header's hamburger
     button — so it is genuinely out of the tab order on desktop (a
     `display: none` element is never a Tab stop), not just visually inert.
     The static label above takes its place there. */
  .sitemap-toggle {
    display: none;
    width: 100%;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
  }

  @media (max-width: 720px) {
    .sitemap-label {
      display: none;
    }

    .sitemap-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .sitemap-chevron {
      flex: 0 0 auto;
      width: 8px;
      height: 8px;
      margin-left: var(--space-2);
      border-right: 1.5px solid var(--soft);
      border-bottom: 1.5px solid var(--soft);
      transform: rotate(45deg);
      transition: transform 150ms ease;
    }

    .sitemap-toggle[aria-expanded='true'] .sitemap-chevron {
      transform: rotate(-135deg);
    }

    #sitemap-list {
      display: none;
    }

    #sitemap-list.is-open {
      display: flex;
    }
  }

  .footer-col a {
    text-decoration: none;
    font-size: 14px;
    color: var(--ink);
  }

  .footer-col a:hover {
    color: var(--green);
  }

  .eyebrow {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0;
  }

  .blurb {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--soft);
    margin: var(--space-2) 0 0;
    max-width: 34ch;
  }

  address {
    font-style: normal;
    font-size: 14px;
    line-height: 1.8;
    margin-top: var(--space-2);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Specificity note: needs to beat ".footer-col ul" above (which sets
     flex-direction: column), so this is qualified with .footer-col rather than
     left as a bare .social-list rule. */
  .footer-col .social-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-3);
  }

  /* The accounts are not live yet, so these point at "#" — but they are real
     buttons: they fill green on hover, take a focus ring, and press in on
     :active, so the control never feels dead under the pointer. */
  .footer-col .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--white);
    color: var(--soft);
  }

  .footer-col .social-icon:hover,
  .footer-col .social-icon:focus-visible {
    background: var(--green);
    border-color: var(--green);
    color: var(--paper);
  }

  /* Brand marks are solid glyphs, not line drawings — the previous 16px
     stroked versions were too light and too small to be read as logos. */
  .social-icon svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
    stroke: none;
  }

  /* Both actions in one object, so the footer has a single place to "do
     something" instead of a button adrift in a nav column. A subtle lift
     (the shared --shadow-soft token, never an ad-hoc shadow) keeps it from
     reading as flat as a bare-bordered box against the beige footer. */
  .action-panel {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    padding: var(--space-3);
  }

  .action-panel .blurb {
    max-width: none;
  }

  /* Pinned to the panel's foot with margin-top: auto, so when the panel is
     stretched to match the brand column's height (see .footer-actions
     above) the extra room opens as one gap here rather than stranding the
     CTA mid-card or padding out the bottom edge. */
  .action-bottom {
    margin-top: auto;
  }

  .action-rule {
    margin: var(--space-3) 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  /* .footer-col a (above) sets color: var(--ink) with specificity (class +
     type) that a bare .footer-cta class can't outrank — qualified with the
     parent class here so the button's paper-on-green text actually wins. */
  .footer-col .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    margin-top: var(--space-2);
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    padding: 11px 18px;
    border-radius: var(--radius-s);
    background: var(--green);
    color: var(--paper);
    border: 1px solid var(--green);
  }

  .footer-col .footer-cta:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
    color: var(--paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-col .social-icon,
    .footer-col .footer-cta {
      transition:
        background-color 250ms ease,
        border-color 250ms ease,
        color 250ms ease,
        transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .footer-col .social-icon:hover {
      transform: translateY(-2px);
    }

    .footer-col .social-icon:active,
    .footer-col .footer-cta:active {
      transform: scale(0.94);
    }

    .footer-cta .btn-arrow {
      transition: transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    .footer-cta:hover .btn-arrow {
      transform: translateX(3px);
    }
  }

  .newsletter-form {
    margin-top: var(--space-2);
  }

  .newsletter-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 720px) {
    .newsletter-row {
      flex-direction: row;
    }
  }

  .newsletter-row input {
    width: 100%;
    min-width: 0;
    font-family: var(--f-sans);
    font-size: 14px;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    padding: 10px 12px;
  }

  @media (min-width: 720px) {
    .newsletter-row input {
      flex: 1;
    }
  }

  .newsletter-submit {
    flex-shrink: 0;
    text-decoration: none;
    background: var(--green);
    color: var(--paper);
    font-weight: 600;
    font-size: 13px;
    padding: 9px 16px;
    border: 1px solid var(--green);
    cursor: pointer;
  }

  .newsletter-submit:hover {
    opacity: 0.92;
  }

  .newsletter-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .newsletter-status {
    margin: var(--space-1) 0 0;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--green);
    min-height: 1em;
  }

  .newsletter-status.is-error {
    color: var(--signal-ink);
  }

  .footer-baseline {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  .baseline-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 12px;
    color: var(--soft);
  }

  .credit {
    text-decoration: none;
  }

  .credit-label {
    color: var(--soft);
  }

  .credit-brand {
    /* --gold-ink, not --gold: bare --gold on --paper is 2.09:1, axe-flagged. */
    color: var(--gold-ink);
    font-weight: 600;
  }

  .credit:hover .credit-brand,
  .credit:focus .credit-brand {
    text-decoration: underline;
  }

  .strapline {
    color: var(--soft);
  }

  /* ---------- mobile: compact, centred ---------- */
  @media (max-width: 640px) {
    .footer-inner {
      padding-top: var(--space-4);
    }

    .footer-grid {
      gap: var(--space-4);
    }

    .baseline-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
