---
// Site footer. Nav column reuses the canonical NAV_ITEMS so it can never
// disagree with the header, plus the company contact block. The baseline
// row (copyright, designer credit, strap line) is locked copy from
// blueprint.md's Global section — do not reword it.
import Wordmark from './Wordmark.astro';
import { NAV_ITEMS } from '../lib/nav';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-col">
        <p class="eyebrow">Explore</p>
        <ul>
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-col footer-company">
        <Wordmark markSize={26} />
        <address>
          Nairobi, Kenya
          <br />
          <a href="tel:+254722861682">+254 722 861 682</a>
          <br />
          <a href="mailto:info@propagafrica.com">info@propagafrica.com</a>
          <br />
          Stock held in Kenya and Ethiopia
        </address>
      </div>
    </div>
    <div class="footer-baseline">
      <p class="baseline-row">
        <span>&copy; {year} PropagAfrica Technologies</span>
        <a class="credit" href="https://navac.co.ke">
          Designed by NAVAC GLOBAL
        </a>
      </p>
      <p class="strapline">Together we grow Africa&rsquo;s horticulture.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--side-gutter) var(--space-3);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .footer-company {
      grid-column: 4;
    }
  }

  .footer-col ul {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-col a {
    text-decoration: none;
    font-size: 14px;
    color: var(--ink);
  }

  .footer-col a:hover {
    color: var(--green);
  }

  address {
    font-style: normal;
    font-size: 14px;
    line-height: 1.8;
    margin-top: var(--space-2);
  }

  .footer-baseline {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  .baseline-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 12px;
    color: var(--soft);
  }

  .credit {
    /* --gold-ink, not --gold: bare --gold on --paper is 2.09:1, axe-flagged. */
    color: var(--gold-ink);
    text-decoration: none;
  }

  .credit:hover,
  .credit:focus {
    text-decoration: none;
  }

  .strapline {
    margin-top: var(--space-2);
    text-align: center;
    font-size: 12px;
    color: var(--soft);
  }
</style>
