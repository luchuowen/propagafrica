---
// Eyebrow, H1, standfirst and a drawing-sheet title block, laid out the same
// way as the site's shared TitleBlock arrangement (see Mark/TitleBlock.astro).
//
// This does not import the shared TitleBlock component: that component's
// five row labels (DWG NO. / SUBJECT / PRINCIPAL SKU / KEY DIM. / SCALE) are
// fixed and cannot express the field names the copy deck specifies per page
// (e.g. GRADES, PACK, TERRITORY, SHEET) without editing a frozen file. The
// row markup and styling below intentionally mirror TitleBlock.astro so the
// drawing-sheet arrangement stays visually identical.
export interface TitleRow {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  standfirst: string;
  titleBlockRows: TitleRow[];
}

const { eyebrow, title, standfirst, titleBlockRows } = Astro.props;
---

<header class="stage-header">
  <div class="stage-header-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="standfirst">{standfirst}</p>
  </div>
  <dl class="stage-title-block">
    {titleBlockRows.map((row) => (
      <div class="row">
        <dt>{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))}
  </dl>
</header>

<style>
  .stage-header {
    padding: var(--space-6) 0 var(--space-5);
    max-width: var(--content-max);
    margin: 0 auto;
    padding-left: var(--side-gutter);
    padding-right: var(--side-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 900px) {
    .stage-header {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .stage-header-copy {
    min-width: 0;
    max-width: 46em;
  }

  .stage-header-copy .eyebrow {
    margin-bottom: var(--space-2);
  }

  .standfirst {
    margin-top: var(--space-3);
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 42em;
  }

  .stage-title-block {
    border: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 10.5px;
    width: max-content;
    max-width: 100%;
    min-width: 0;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr);
    border-top: 1px solid var(--rule);
  }

  .row:first-child {
    border-top: none;
  }

  dt,
  dd {
    margin: 0;
    padding: 5px 10px;
    font-variant-numeric: tabular-nums;
  }

  dt {
    color: var(--ink-soft);
    border-right: 1px solid var(--rule);
    white-space: nowrap;
  }

  dd {
    color: var(--ink);
    word-break: break-word;
  }
</style>
