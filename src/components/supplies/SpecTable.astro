---
// A specification table: mono throughout, hairline rules, no card, no shadow,
// no zebra striping. Always wrapped in a horizontally-scrollable container so
// a wide table never forces the page itself to scroll sideways.
export interface SpecColumn {
  key: string;
  label: string;
}

interface Props {
  caption: string;
  columns: SpecColumn[];
  rows: Record<string, string>[];
}

const { caption, columns, rows } = Astro.props;

const captionId = `spec-caption-${caption
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')}`;
---

<figure class="spec-table">
  <figcaption id={captionId} class="spec-caption">
    {caption}
  </figcaption>
  <div class="spec-scroll">
    <table aria-labelledby={captionId}>
      <thead>
        <tr>
          {columns.map((column) => (
            <th scope="col">{column.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            {columns.map((column) => (
              <td>{row[column.key]}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>

<style>
  .spec-table {
    margin: 0;
  }

  .spec-caption {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  .spec-scroll {
    overflow-x: auto;
    min-width: 0;
  }

  table {
    width: 100%;
    min-width: 34em;
    border-collapse: collapse;
    font-family: var(--f-mono);
    font-variant-numeric: tabular-nums;
    font-size: 11px;
  }

  th,
  td {
    text-align: left;
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }

  th {
    font-weight: 500;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--ink-soft);
  }

  td {
    color: var(--ink);
  }
</style>
