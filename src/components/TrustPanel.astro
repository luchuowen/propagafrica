---
// The "Why partner with PropagAfrica" / "Who we supply" two-column panel —
// blueprint.md's Product Reference lists, verbatim. Shared by the homepage
// and the About page (blueprint.md Section 12) so the markup and the list
// content aren't retyped on the second page.
//
// Two matching panels on --green-dark, each numbered, so every line has a left
// edge to sit against instead of trailing off into empty ground. They were a
// plain pair of lists at identical weight on the section's own mint, which
// read as one table split in half.
import { WHY_PARTNER, TARGET_MARKETS } from '../data/trust';

const PANELS = [
  {
    eyebrow: 'Why us',
    heading: 'Why partner with PropagAfrica',
    items: WHY_PARTNER,
  },
  {
    eyebrow: 'Target markets',
    heading: 'Who we supply',
    items: TARGET_MARKETS,
  },
] as const;
---

<section class="trust">
  <div class="trust-inner" data-reveal-group>
    {PANELS.map((panel) => (
      <div class="trust-panel" data-reveal>
        <p class="eyebrow">{panel.eyebrow}</p>
        <h2>{panel.heading}</h2>
        <ol class="trust-list">
          {panel.items.map((item, i) => (
            <li>
              <span class="trust-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="trust-item">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--mint);
    padding: var(--space-6) 0;
  }

  .trust-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .trust-inner {
      grid-template-columns: repeat(2, 1fr);
      align-items: stretch;
    }
  }

  .trust-panel {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border-radius: var(--radius-l);
    background: var(--green-dark);
    color: var(--paper);
  }

  @media (min-width: 720px) {
    .trust-panel {
      padding: var(--space-5) var(--space-4);
    }
  }

  .trust-panel .eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--paper);
    opacity: 0.62;
  }

  .trust-panel h2 {
    margin: 0;
    font-size: 23px;
    letter-spacing: -0.022em;
    line-height: 1.25;
    color: var(--paper);
  }

  .trust-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  /* A fixed first column keeps every numeral and every label on the same two
     vertical rules, in both panels. */
  .trust-list li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: baseline;
    padding: var(--space-2) 0;
    border-top: 1px solid color-mix(in srgb, var(--paper) 22%, transparent);
  }

  /* --mint-bright on --green-dark is 3.76:1 — under AA for 11px text. Lifting
     it towards paper takes the numeral to 5.3:1 while it still reads as the
     accent rather than plain white. */
  .trust-n {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--mint-bright) 70%, var(--paper));
  }

  .trust-item {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
