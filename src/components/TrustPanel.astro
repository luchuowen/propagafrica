---
// The "Why partner with PropagAfrica" / "Who we supply" two-column panel —
// blueprint.md's Product Reference lists, verbatim. Shared by the homepage
// and the About page (blueprint.md Section 12) so the markup and the list
// content aren't retyped on the second page.
import { WHY_PARTNER, TARGET_MARKETS } from '../data/trust';
---

<section class="trust">
  <div class="trust-inner" data-reveal-group>
    <div class="trust-col" data-reveal>
      <h2>Why partner with Us</h2>
      <ul class="check-list">
        {WHY_PARTNER.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="trust-col" data-reveal>
      <h2>Who we supply</h2>
      <ul class="check-list">
        {TARGET_MARKETS.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--mint);
    padding: var(--space-6) 0;
  }

  .trust-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--side-gutter);
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 720px) {
    .trust-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
      align-items: start;
    }
  }

  .trust-col {
    text-align: center;
  }

  .check-list {
    list-style: none;
    margin: var(--space-2) auto 0;
    padding: 0;
    max-width: 34ch;
    display: grid;
    gap: 0;
  }

  .check-list li {
    padding: 6px 0;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.5;
  }

  .check-list li:first-child {
    border-top: none;
  }
</style>
