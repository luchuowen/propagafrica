---
// A full-width drawing figure. The graphic and its caption sit side by
// side, never stacked into a card. Every figure carries a sheet footer:
// FIG. 0n · SUBJECT · REV. A on the left, SHEET 0n OF 14 on the right.
interface Props {
  number: number;
  subject: string;
  caption: string;
  revision?: string;
  sheet?: number;
  sheetsTotal?: number;
}

const { number, subject, caption, revision = 'A', sheet = 1, sheetsTotal = 14 } = Astro.props;

const figNo = String(number).padStart(2, '0');
const sheetNo = String(sheet).padStart(2, '0');
---

<figure class="figure">
  <div class="figure-grid">
    <div class="figure-graphic">
      <slot />
    </div>
    <figcaption class="figure-caption">
      <p class="figure-label">
        <span class="figure-tick" aria-hidden="true"></span>FIG. {figNo}
      </p>
      <p class="figure-text">{caption}</p>
    </figcaption>
  </div>
  <div class="figure-footer">
    <span>
      FIG. {figNo} · {subject.toUpperCase()} · REV. {revision}
    </span>
    <span>
      SHEET {sheetNo} OF {sheetsTotal}
    </span>
  </div>
</figure>

<style>
  .figure {
    margin: 0;
    width: 100%;
  }

  .figure-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 800px) {
    .figure-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-5);
    }
  }

  .figure-graphic :global(svg) {
    width: 100%;
    height: auto;
  }

  .figure-caption {
    font-family: var(--f-sans);
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .figure-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: var(--space-1);
  }

  .figure-tick {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--signal);
    flex-shrink: 0;
  }

  .figure-text {
    margin: 0;
  }

  .figure-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-1);
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
</style>
