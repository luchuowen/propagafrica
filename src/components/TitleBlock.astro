---
// The drawing title block: a bordered key/value panel, mono throughout,
// sitting top-right of a page's hero. Five fixed rows.
interface Props {
  drawingNo: string;
  subject: string;
  sku?: string;
  dimension?: string;
  scale?: string;
}

const { drawingNo, subject, sku = '—', dimension = '—', scale = 'NTS' } = Astro.props;

const rows: [string, string][] = [
  ['DWG NO.', drawingNo],
  ['SUBJECT', subject],
  ['PRINCIPAL SKU', sku],
  ['KEY DIM.', dimension],
  ['SCALE', scale],
];
---

<dl class="title-block">
  {rows.map(([label, value]) => (
    <div class="row">
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .title-block {
    border: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 10.5px;
    width: max-content;
    max-width: 100%;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    border-top: 1px solid var(--rule);
  }

  .row:first-child {
    border-top: none;
  }

  dt,
  dd {
    margin: 0;
    padding: 5px 10px;
    font-variant-numeric: tabular-nums;
  }

  dt {
    color: var(--ink-soft);
    border-right: 1px solid var(--rule);
    white-space: nowrap;
  }

  dd {
    color: var(--ink);
    word-break: break-word;
  }
</style>
