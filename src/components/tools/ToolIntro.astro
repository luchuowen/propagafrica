---
// The header shared by both calculator pages: eyebrow, H1, one-line sub, a
// contained photograph (not full-bleed — these are working tool pages, not
// product marketing pages, so the photo illustrates rather than dominates)
// and a short "how it works" paragraph beside it — the photo alone left a
// wide dead gap to its right at desktop widths once it's capped at 560px.
interface Props {
  eyebrow: string;
  title: string;
  sub: string;
  image: string;
  imageAlt: string;
  howItWorks: string;
}

const { eyebrow, title, sub, image, imageAlt, howItWorks } = Astro.props;
---

<header class="tool-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="tool-sub">{sub}</p>
  <div class="tool-media-row">
    <figure class="tool-photo">
      <img src={image} alt={imageAlt} loading="eager" />
    </figure>
    <p class="tool-how">{howItWorks}</p>
  </div>
</header>

<style>
  .tool-intro {
    padding-top: var(--space-2);
  }

  h1 {
    margin-top: var(--space-2);
    max-width: 26ch;
  }

  .tool-sub {
    margin-top: var(--space-3);
    font-size: 17px;
    line-height: 1.65;
    color: var(--soft);
    max-width: 60ch;
  }

  .tool-media-row {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tool-photo {
    flex: 1 1 480px;
    max-width: 560px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--mint);
  }

  .tool-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tool-how {
    flex: 1 1 260px;
    min-width: 240px;
    margin: 0;
    padding-top: var(--space-1);
    font-size: 15px;
    line-height: 1.65;
    color: var(--soft);
  }

  /* text-align only centres each block's own wrapped lines within its own
     box — h1 and .tool-sub each cap their own width narrower than
     .tool-intro (26ch/60ch), so both also need auto margins to sit centred
     rather than flush left with centred text staggered inside a
     left-anchored box. */
  @media (max-width: 640px) {
    .tool-intro > .eyebrow,
    .tool-intro > h1,
    .tool-intro > .tool-sub,
    .tool-how {
      text-align: center;
    }

    .tool-intro > h1,
    .tool-intro > .tool-sub {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
