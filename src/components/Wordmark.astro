---
// The wordmark lockup: mark + two-tone "PropagAfrica" + "TECHNOLOGIES" strap
// line. Casing is fixed: "PropagAfrica" title case, never all-caps. "Propag"
// and "Africa" carry the two brand tones; the strap is JetBrains Mono
// capitals, width-matched to the wordmark via the flex-letter-span technique.
import Mark from './Mark.astro';

interface Props {
  tone?: 'light' | 'dark';
  markSize?: number;
}

const { tone = 'light', markSize = 34 } = Astro.props;
const propagColor = tone === 'dark' ? 'var(--white)' : 'var(--ink)';
const africaColor = tone === 'dark' ? 'var(--mint-bright)' : 'var(--green)';
const STRAP = 'TECHNOLOGIES'.split('');
---

<a href="/" class="wordmark" aria-label="PropagAfrica Technologies — home">
  <Mark size={markSize} tone={tone} />
  <span class="wordmark-text">
    <!-- prettier-ignore -->
    <span class="name"><span class="propag" style={`color: ${propagColor}`}>Propag</span><span class="africa" style={`color: ${africaColor}`}>Africa</span></span>
    <span class="strap" style={`color: ${tone === 'dark' ? 'var(--white)' : 'var(--soft)'}`}>
      {STRAP.map((letter) => (
        <span>{letter}</span>
      ))}
    </span>
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
  }

  .wordmark-text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }

  .name {
    font-family: var(--f-sans);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 19px;
    white-space: nowrap;
  }

  .strap {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: 4px;
    font-family: var(--f-mono);
    font-size: 6.8px;
    text-transform: uppercase;
  }
</style>
