---
// The PropagAfrica plant mark: a central node, one root and three shoots,
// each shoot tipped with an accent dot. Do not redraw, do not add a leaf
// shape, do not place inside a circle or badge beyond its own centre node.
interface Props {
  size?: number;
  tone?: 'light' | 'dark';
}

const { size = 44, tone = 'light' } = Astro.props;
const stroke = tone === 'dark' ? 'var(--white)' : 'var(--green)';
const thirdDot = tone === 'dark' ? 'var(--mint-bright)' : 'var(--green)';
---

<svg
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role="img"
  aria-label="PropagAfrica Technologies"
  style={`color: ${stroke}`}
>
  <g fill="none" stroke="currentColor" stroke-width="4.2" stroke-linecap="round">
    <path d="M32 34 L32 52"></path>
    <path d="M32 34 L16 16"></path>
    <path d="M32 34 L44 14"></path>
    <path d="M32 34 L48 30"></path>
  </g>
  <circle cx="32" cy="34" r="4.6" fill="currentColor"></circle>
  <circle cx="16" cy="16" r="3.6" style="fill: var(--terra)"></circle>
  <circle cx="44" cy="14" r="3.6" style="fill: var(--gold)"></circle>
  <circle cx="48" cy="30" r="3.6" style={`fill: ${thirdDot}`}></circle>
</svg>
