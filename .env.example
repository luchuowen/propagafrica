# Environment variables for the quotation backend (functions/) and the /admin front end.
# Never commit real values — copy this file, fill it in, and keep the copy out of git.
#
# Cloud Functions (2nd gen, europe-west1) read these from the deployed function's environment
# (`firebase functions:secrets:set` / `firebase deploy --only functions` env config) or, for the
# local emulator, from functions/.env (gitignored; functions/.env.example mirrors this file).

# --- Email notification (functions/src/email.ts) ---------------------------
# Only "resend" is implemented today (a plain HTTPS API call, no SDK dependency).
EMAIL_PROVIDER=resend
# Secret. The provider's API key.
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com
# Verified sending address for the chosen provider.
EMAIL_FROM=
# Where new quotation request notifications are delivered.
EMAIL_TO=

# --- Admin allow-list (functions/src/admin.ts) ------------------------------
# Comma-separated list of email addresses permitted to see quotation requests on /admin.
# An authenticated user whose email is not on this list sees an empty list, not an error.
ALLOWED_ADMIN_EMAILS=

# --- Rate limiting (functions/src/rateLimit.ts, functions/src/hash.ts) -----
# Secret. Pepper mixed into the hashed rate-limit identifier and never stored or logged in the
# clear. Rotating it resets everyone's rate-limit window.
RATE_LIMIT_HASH_SALT=

# --- /admin front end (src/pages/admin/index.astro) -------------------------
# Firebase web app config. These are public identifiers, not secrets — Firebase's own docs say
# they are safe to expose in client-side code — but they are still project-specific, so they are
# read from the build environment rather than hard-coded. Read via import.meta.env.PUBLIC_* at
# build time (see astro.config.mjs / Astro's built-in .env support), and only used to bootstrap
# the Firebase Auth Web SDK for the email-link sign-in flow described in session-6.md.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
