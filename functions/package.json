{
  "name": "propagafrica-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions (2nd gen, europe-west1) for the PropagAfrica quotation request path.",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
