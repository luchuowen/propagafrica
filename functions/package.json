  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.20.2",
    "firebase-tools": "^13.35.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
