# Local/emulator copy of the environment variables documented in the repo root .env.example.
# Copy this file to functions/.env for `firebase emulators:start` and fill in real values —
# functions/.env is gitignored and must never be committed.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_FROM=
EMAIL_TO=
ALLOWED_ADMIN_EMAILS=
RATE_LIMIT_HASH_SALT=
